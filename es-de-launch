# Génération de la conf (--init)
# ==========================================================================

def generate_conf(path, args, force=False):
    if os.path.exists(path) and not force:
        raise LaunchError("%s existe déjà (utilisez --force)" % path, EXIT_USAGE)
    found = detect_install()
    config_dir = os.path.abspath(expand(args.config_dir)) if args.config_dir else detect_config_dir()
    conf = Conf()
    lines_others = []
    if args.resources_dir:
        conf.cp.set("install", "type", "manual")
        conf.cp.set("install", "resources_dir", args.resources_dir)
    elif found:
        best = found[0]
        if not best["valid"]:
            warn("installation trouvée (%s) mais ressources absentes de %s"
                 % (best["executable"], best["resources_dir"]))
        conf.cp.set("install", "type", best["type"])
        conf.cp.set("install", "executable", best["executable"])
        if best["type"] != "appimage" and best["resources_dir"]:
            conf.cp.set("install", "resources_dir", best["resources_dir"])
        if best["type"] in SANDBOXED:
            lines_others.append("# attention : installation %s, aucune version de ce type n'est prévue par ES-DE"
                                % best["type"])
        for other in found[1:]:
            lines_others.append("# autre installation trouvée : %s %s (%s)"
                                % (other["type"], other["executable"] or other["resources_dir"],
                                   "exploitable" if other["valid"] else "sans ressources"))
    else:
        warn("aucune installation ES-DE détectée ; complétez [install] à la main")
        conf.cp.set("install", "type", "manual")
    conf.cp.set("install", "config_dir", config_dir)

    # Priorités : nécessitent la config ES-DE
    try:
        ns = argparse.Namespace(config_dir=config_dir, resources_dir=args.resources_dir, refresh_cache=False)
        ctx = build_context(conf, ns)
        lib = ctx.library_systems()

        def count_games(s):
            g = Gamelist.load(ctx, s)
            return len(g.games)
        lib.sort(key=lambda s: (-count_games(s), s.order))
        conf.cp.set("systems", "priority", ", ".join(s.name for s in lib))
        ext_map = {}
        for s in lib:
            for e in s.extensions:
                ext_map.setdefault(e.lstrip(".").lower(), [])
                if s.name not in ext_map[e.lstrip(".").lower()]:
                    ext_map[e.lstrip(".").lower()].append(s.name)
        for e, names in sorted(ext_map.items()):
            if len(names) > 1 and e:
                conf.cp.set("extensions", e, ", ".join(names))
    except LaunchError as e:
        warn("priorités non générées : %s" % e)

    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    if os.path.exists(path):
        shutil.copyfile(path, path + ".bak")
    header = ["# Généré par es-de-launch --init le %s" % datetime.date.today().isoformat(),
              "# [launch] scripts : always | auto (suit CustomEventScripts) | never",
              "# [launch] ambiguity : ask | first | fail",
              "# [extensions] ext = systèmes candidats, du plus au moins prioritaire",
              "# [folders] /chemin/hors/bibliotheque = système",
              "# [mime] type/mime = système"] + lines_others
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(header) + "\n\n")
        conf.cp.write(fh)
    conf.path = path
    return conf


def load_or_init_conf(args):
    path = expand(args.conf) if args.conf else default_conf_path()
    if os.path.isfile(path):
        return Conf.load(path)
    print("es-de-launch : %s absent, détection de l'installation..." % path, file=sys.stderr)
    try:
        conf = generate_conf(path, args)
        print("es-de-launch : configuration écrite dans %s" % path, file=sys.stderr)
        return conf
    except OSError as e:
        warn("impossible d'écrire %s (%s) : configuration en mémoire" % (path, e))
        return Conf()


