def parse_xml_lenient(path, root_tag="root"):
    """Lit un XML qui peut ne pas avoir d'élément racine (es_settings.xml)."""
    with open(path, encoding="utf-8", errors="replace") as fh:
        text = fh.read()
    text = re.sub(r"<\?xml[^>]*\?>", "", text, count=1)
    try:
        return ET.fromstring(text)
    except ET.ParseError:
        return ET.fromstring("<%s>%s</%s>" % (root_tag, text, root_tag))


def parse_xml_file(path):
    """ET.parse avec un message clair (code 3) si le fichier est mal formé."""
    try:
        return ET.parse(path).getroot()
    except ET.ParseError as e:
        raise LaunchError("XML invalide : %s (%s)" % (path, e), EXIT_CONFIG)
    except OSError as e:
        raise LaunchError("lecture impossible : %s (%s)" % (path, e), EXIT_CONFIG)


def load_settings(config_dir):
    """Réglages utiles d'es_settings.xml."""
    settings = {"ROMDirectory": "", "CustomEventScripts": False}
    path = os.path.join(config_dir, "settings", "es_settings.xml")
    if not os.path.isfile(path):
        log("es_settings.xml absent : réglages par défaut")
    else:
        try:
            root = parse_xml_lenient(path)
        except ET.ParseError as e:
            raise LaunchError("XML invalide : %s (%s)" % (path, e), EXIT_CONFIG)
        for el in root.iter():
            name = el.get("name")
            value = el.get("value")
            if name is None or value is None:
                continue
            if el.tag == "bool":
                settings[name] = value.lower() == "true"
            else:
                settings[name] = value
    rom_dir = settings.get("ROMDirectory") or "~/ROMs"
    settings["ROMDirectory"] = os.path.abspath(expand(rom_dir))
    return settings


class System:
    def __init__(self, name):
        self.name = name
        self.fullname = name
        self.path_raw = ""
        self.path = ""
        self.extensions = []
        self.commands = []  # liste de (label, commande)
        self.platforms = []
        self.theme = ""
        self.custom = False
        self.order = 0

    def accepts(self, ext, ignore_case=False):
        if ignore_case:
            return ext.lower() in (e.lower() for e in self.extensions)
        return ext in self.extensions

    def to_dict(self):
        return {
            "name": self.name,
            "fullname": self.fullname,
            "path": self.path,
            "platforms": self.platforms,
            "extensions": self.extensions,
            "commands": [label for label, _ in self.commands],
        }


def _parse_systems_file(path, custom):
    root = parse_xml_file(path)
    result = []
    for el in root.findall("system"):
        name = (el.findtext("name") or "").strip()
        if not name:
            continue
        s = System(name)
        s.custom = custom
        s.fullname = (el.findtext("fullname") or name).strip()
        s.path_raw = (el.findtext("path") or "").strip()
        s.extensions = (el.findtext("extension") or "").split()
        for i, c in enumerate(el.findall("command")):
            label = c.get("label") or ("Commande %d" % (i + 1))
            s.commands.append((label, (c.text or "").strip()))
        s.platforms = [p.strip() for p in (el.findtext("platform") or "").split(",") if p.strip()]
        s.theme = (el.findtext("theme") or "").strip()
        result.append(s)
    return result


def load_systems(resources_dir, config_dir, rom_dir):
    """Fusion custom_systems/es_systems.xml + es_systems.xml embarqué (spec §3)."""
    bundled = os.path.join(resources_dir, "es_systems.xml")
    if not os.path.isfile(bundled):
        raise LaunchError("es_systems.xml introuvable dans %s" % resources_dir, EXIT_CONFIG)
    systems = {}
    order = []
    custom = os.path.join(config_dir, "custom_systems", "es_systems.xml")
    if os.path.isfile(custom):
        for s in _parse_systems_file(custom, True):
            if s.name not in systems:
                systems[s.name] = s
                order.append(s.name)
        log("systèmes personnalisés : %s" % ", ".join(order))
    for s in _parse_systems_file(bundled, False):
        if s.name not in systems:
            systems[s.name] = s
            order.append(s.name)
    for i, name in enumerate(order):
        s = systems[name]
        s.order = i
        p = s.path_raw.replace("%ROMPATH%", rom_dir)
        s.path = os.path.abspath(expand(p)) if p else ""
    return systems


def load_find_rules(resources_dir, config_dir):
    """Retourne (emulators, cores) : nom -> liste de (type, [entrées])."""
    emulators, cores = {}, {}

    def read(path, target_emu, target_core, override):
        root = parse_xml_file(path)
        for tag, target in (("emulator", target_emu), ("core", target_core)):
            for el in root.findall(tag):
                name = el.get("name")
                if not name or (name in target and not override):
                    continue
                rules = []
                for r in el.findall("rule"):
                    entries = [(e.text or "").strip() for e in r.findall("entry") if (e.text or "").strip()]
                    rules.append((r.get("type"), entries))
                target[name] = rules

    custom = os.path.join(config_dir, "custom_systems", "es_find_rules.xml")
    if os.path.isfile(custom):
        read(custom, emulators, cores, True)
    bundled = os.path.join(resources_dir, "es_find_rules.xml")
    if not os.path.isfile(bundled):
        raise LaunchError("es_find_rules.xml introuvable dans %s" % resources_dir, EXIT_CONFIG)
    read(bundled, emulators, cores, False)
    return emulators, cores


class Gamelist:
    def __init__(self):
        self.alt_emulator = None
        self.games = {}  # chemin absolu -> dict

    @staticmethod
    def load(config_dir, system):
        g = Gamelist()
        path = os.path.join(config_dir, "gamelists", system.name, "gamelist.xml")
        if not os.path.isfile(path):
            return g
        try:
            root = parse_xml_lenient(path, "gameList")
        except ET.ParseError as e:
            warn("gamelist illisible (%s) : %s" % (path, e))
            return g
        for el in root.iter("alternativeEmulator"):
            label = (el.findtext("label") or "").strip()
            if label:
                g.alt_emulator = label
        for el in root.iter("game"):
            rel = (el.findtext("path") or "").strip()
            if not rel:
                continue
            if rel.startswith("./"):
                full = os.path.join(system.path, rel[2:])
            else:
                full = expand(rel)
            info = {child.tag: (child.text or "").strip() for child in el}
            g.games[os.path.normpath(full)] = info
        return g

    def game(self, rom):
        return self.games.get(os.path.normpath(rom))


# ==========================================================================
# Configuration du lanceur (es-de-launch.conf) — spec §3.2
# ==========================================================================

DEFAULT_CONF = {
    "general": {"version": "1"},
    "install": {
        "type": "auto",
        "executable": "",
        "config_dir": "~/ES-DE",
        "resources_dir": "auto",
        "cache_dir": "",
    },
    "launch": {"scripts": "always", "ambiguity": "ask"},
    "systems": {"priority": "", "exclude": ""},
}


def new_confparser():
    cp = configparser.ConfigParser(interpolation=None, delimiters=("=",))
    cp.optionxform = str  # garde la casse (types MIME, chemins)
    return cp


def default_conf_path():
    return os.path.join(xdg_config_home(), "es-de-launch.conf")


class Conf:
    def __init__(self, cp=None, path=None):
        self.cp = cp or new_confparser()
        self.path = path
        for section, values in DEFAULT_CONF.items():
            if not self.cp.has_section(section):
                self.cp.add_section(section)
            for k, v in values.items():
                if not self.cp.has_option(section, k):
                    self.cp.set(section, k, v)
        for section in ("extensions", "folders", "mime"):
            if not self.cp.has_section(section):
                self.cp.add_section(section)

    @staticmethod
    def load(path):
        cp = new_confparser()
        cp.read(path, encoding="utf-8")
        known = set(DEFAULT_CONF) | {"extensions", "folders", "mime"}
        for s in cp.sections():
            if s not in known:
                warn("section inconnue [%s] dans %s" % (s, path))
        return Conf(cp, path)

    def get(self, section, key, default=""):
        return self.cp.get(section, key, fallback=default)

    def list(self, section, key):
        return [x.strip() for x in self.get(section, key).split(",") if x.strip()]

    @property
    def cache_dir(self):
        c = self.get("install", "cache_dir")
        return expand(c) if c else os.path.join(xdg_cache_home(), "es-de-launch")

    def ext_priority(self, ext):
        key = ext.lstrip(".")
        for k in (key, key.lower()):
            if self.cp.has_option("extensions", k):
                return self.list("extensions", k)
        return []

    def folders(self):
        return {os.path.abspath(expand(k)): v.strip() for k, v in self.cp.items("folders")}

    def mime_overrides(self):
        return {k: v.strip() for k, v in self.cp.items("mime")}


# ==========================================================================
# Détection de l'installation ES-DE — spec §3.1
# ==========================================================================
#
# Types reconnus :
#   appimage  exécutable AppImage (ressources dans l'image, extraites en cache)
#   system    paquet de distribution : /usr/bin/es-de + /usr/share/es-de/resources
#   local     compilation installée : <préfixe>/bin/es-de + <préfixe>/share/es-de/resources
#   portable  binaire avec un dossier resources/ à côté
#   flatpak   ressources dans <installation flatpak>/app/<id>/current/active/files/share/es-de
#   snap      ressources dans /snap/<nom>/current/.../share/es-de
#   manual    resources_dir fourni par l'utilisateur
#
# ROOT permet aux tests de simuler une arborescence complète (/usr, /var, /snap).

ROOT = os.environ.get("ES_DE_LAUNCH_ROOT", "")
RES_SUBDIR = os.path.join("es-de", "resources", "systems", "linux")
SANDBOXED = ("flatpak", "snap")


def _r(path):
    """Chemin système, préfixé par ROOT (tests)."""
    return ROOT + path if ROOT else path


def has_resources(d):
    return bool(d) and all(os.path.isfile(os.path.join(d, f)) for f in ("es_systems.xml", "es_find_rules.xml"))


def is_appimage(path):
    """Signature AppImage (« AI » + type à l'octet 8). Repli pour les runtimes non
    standard : ELF contenant une image squashfs ou DwarFS, ou nom en .AppImage."""
    try:
        with open(path, "rb") as fh:
            head = fh.read(4 << 20)
    except OSError:
        return False
    if head[:4] != b"\x7fELF":
        return False
    if head[8:10] == b"AI" and head[10] in (1, 2):
        return True
    if path.lower().endswith(".appimage"):
        return True
    return b"hsqs" in head[0x1000:] or b"DWARFS" in head[0x1000:]


def classify_install(exe):
    """(type, exécutable réel, dossier des ressources ou None pour une AppImage)."""
    real = os.path.realpath(exe)
    if is_appimage(real):
        return "appimage", real, None
    d = os.path.dirname(real)
    portable = os.path.join(d, "resources", "systems", "linux")
    if has_resources(portable):
        return "portable", real, portable
    prefix = os.path.dirname(d)
    res = os.path.join(prefix, "share", RES_SUBDIR)
    if prefix == _r("/usr"):
        return "system", real, res
    return "local", real, res


def _sandbox_installs():
    """Installations Flatpak et Snap, trouvées par leurs ressources (sans connaître l'identifiant)."""
    out = []
    flatpak_roots = [_r("/var/lib/flatpak"), os.path.join(home(), ".local", "share", "flatpak")]
    for base in flatpak_roots:
        for res in sorted(glob.glob(os.path.join(base, "app", "*", "current", "active", "files",
                                                 "share", RES_SUBDIR))):
            app_id = res[len(os.path.join(base, "app")) + 1:].split(os.sep)[0]
            exe = os.path.join(base, "exports", "bin", app_id)
            out.append({"type": "flatpak", "executable": exe if os.path.exists(exe) else "",
                        "real": res, "resources_dir": res, "origin": "flatpak " + app_id})
    for pattern in ("/snap/*/current/usr/share/", "/snap/*/current/share/"):
        for res in sorted(glob.glob(_r(pattern) + RES_SUBDIR)):
            name = res[len(_r("/snap/")):].split(os.sep)[0]
            exe = _r("/snap/bin/" + name)
            out.append({"type": "snap", "executable": exe if os.path.exists(exe) else "",
                        "real": res, "resources_dir": res, "origin": "snap " + name})
    return out


def detect_install():
    """Liste des installations candidates, la plus probable d'abord.
    Chaque entrée : type, executable, real, resources_dir, origin, valid."""
    candidates = []
    seen = set()

    def add(path, origin):
        if not path or not os.path.isfile(path) or not os.access(path, os.X_OK):
            return
        kind, real, res = classify_install(path)
        if real in seen:
            return
        seen.add(real)
        candidates.append({"type": kind, "executable": path, "real": real, "resources_dir": res,
                           "origin": origin, "valid": kind == "appimage" or has_resources(res)})

    # 1. ce que l'utilisateur lance réellement
    add(shutil.which("es-de"), "PATH")
    # 2. emplacements d'AppImage usuels (les mêmes que ceux des règles de recherche d'ES-DE)
    for d in ("Applications", "AppImages", ".local/bin", "bin", ".local/share/applications"):
        for pattern in ("es-de", "ES-DE*.AppImage", "es-de*.AppImage", "*ES-DE*", "*es-de*"):
            for p in sorted(glob.glob(os.path.join(home(), d, pattern))):
                add(p, "~/" + d)
    # 3. paquets et compilations
    for p in ("/usr/bin/es-de", "/usr/games/es-de", "/usr/local/bin/es-de", "/opt/es-de/es-de"):
        add(_r(p), "standard")
    # 4. bacs à sable
    for c in _sandbox_installs():
        if c["real"] not in seen:
            seen.add(c["real"])
            c["valid"] = True
            candidates.append(c)
    # les installations exploitables d'abord, en gardant l'ordre de découverte
    candidates.sort(key=lambda c: not c["valid"])
    return candidates


def resources_from_log(config_dir):
    """Dossier des XML tel qu'ES-DE l'a lu (es_log.txt), s'il est lisible directement.
    Un chemin de bac à sable Flatpak (/app/...) est traduit vers l'hôte."""
    logf = os.path.join(config_dir, "logs", "es_log.txt")
    try:
        with open(logf, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return None
    found = re.findall(r'Parsing systems configuration file "([^"]+)/es_systems\.xml"', text)
    if not found:
        return None
    d = found[-1]
    if d.startswith("/tmp/.mount_"):
        return None  # AppImage : montage temporaire
    if has_resources(_r(d)):
        return _r(d)
    if d.startswith("/app/"):
        for c in _sandbox_installs():
            if c["type"] == "flatpak" and c["resources_dir"].endswith(d[len("/app"):]):
                return c["resources_dir"]
    return None


def detect_config_dir():
    """Dossier de données ES-DE : celui qui contient settings/es_settings.xml."""
    candidates = [os.environ.get("ESDE_APPDATA_DIR"), os.path.join(home(), "ES-DE")]
    for pattern in (".var/app/*/data/ES-DE", ".var/app/*/ES-DE", "snap/*/current/ES-DE", "snap/*/common/ES-DE"):
        candidates += sorted(glob.glob(os.path.join(home(), pattern)))
    candidates.append(os.path.join(home(), ".emulationstation"))
    for d in candidates:
        if d and os.path.isfile(os.path.join(d, "settings", "es_settings.xml")):
            return d
    return os.path.join(home(), "ES-DE")


# ==========================================================================
# Ressources embarquées dans l'AppImage — extraction et cache (spec §3.3)
# ==========================================================================

RES_FILES = ("es_systems.xml", "es_find_rules.xml")
INTERNAL_CANDIDATES = (
    "usr/share/es-de/resources/systems/linux",
    "usr/bin/resources/systems/linux",
)


def internal_path_from_log(config_dir):
    """Chemin interne lu dans es_log.txt ('Parsing systems configuration file ...')."""
    logf = os.path.join(config_dir, "logs", "es_log.txt")
    try:
        with open(logf, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return None
    m = None
    for m in re.finditer(r'Parsing systems configuration file "([^"]+)/es_systems\.xml"', text):
        pass
    if not m:
        return None
    full = m.group(1)
    mm = re.match(r"/tmp/\.mount_[^/]+/(.+)$", full)
    return mm.group(1) if mm else None


def exe_fingerprint(exe):
    real = os.path.realpath(exe)
    st = os.stat(real)
    return {"executable": real, "size": st.st_size, "mtime_ns": st.st_mtime_ns}


def cache_is_valid(cache_res, exe):
    """Valide si : fichiers présents, même exécutable/taille/date, et cache
    créé après la dernière modification de l'exécutable."""
    manifest = os.path.join(cache_res, "manifest.json")
    try:
        with open(manifest, encoding="utf-8") as fh:
            m = json.load(fh)
        fp = exe_fingerprint(exe)
    except (OSError, ValueError):
        return False
    for f in RES_FILES:
        if not os.path.isfile(os.path.join(cache_res, f)):
            return False
    if m.get("executable") != fp["executable"]:
        log("cache invalide : exécutable différent")
        return False
    if m.get("size") != fp["size"] or m.get("mtime_ns") != fp["mtime_ns"]:
        log("cache invalide : l'exécutable a changé")
        return False
    if os.stat(manifest).st_mtime_ns < fp["mtime_ns"]:
        log("cache invalide : plus ancien que l'exécutable")
        return False
    return True


def _copy_res_from(base, rel_paths, dest):
    for rel in rel_paths:
        src = os.path.join(base, rel)
        if all(os.path.isfile(os.path.join(src, f)) for f in RES_FILES):
            for f in RES_FILES:
                shutil.copyfile(os.path.join(src, f), os.path.join(dest, f))
            return rel
    # dernier recours : recherche
    for root, _dirs, files in os.walk(base):
        if "es_systems.xml" in files and "es_find_rules.xml" in files and root.endswith("linux"):
            for f in RES_FILES:
                shutil.copyfile(os.path.join(root, f), os.path.join(dest, f))
            return os.path.relpath(root, base)
    return None


def _extract_by_mount(appimage, rel_paths, dest, timeout=15):
    """Méthode principale : --appimage-mount, copie, puis arrêt du montage."""
    proc = subprocess.Popen([appimage, "--appimage-mount"], stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                            start_new_session=True)
    try:
        ready, _, _ = select.select([proc.stdout], [], [], timeout)
        if not ready:
            raise LaunchError("--appimage-mount n'a pas répondu", EXIT_CONFIG)
        mount = proc.stdout.readline().decode(errors="replace").strip()
        log("AppImage montée sur %s" % mount)
        if not mount or not os.path.isdir(mount):
            raise LaunchError("point de montage invalide : %r" % mount, EXIT_CONFIG)
        return _copy_res_from(mount, rel_paths, dest)
    finally:
        # on ne termine que notre propre processus de montage
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
        proc.stdout.close()


def _extract_by_extract(appimage, rel_paths, dest):
    """Repli : --appimage-extract sur le chemin réel, dans un dossier temporaire."""
    with tempfile.TemporaryDirectory(prefix="es-de-launch-") as tmp:
        for rel in rel_paths:
            for f in RES_FILES:
                subprocess.run([appimage, "--appimage-extract", rel + "/" + f], cwd=tmp,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
        for top in ("squashfs-root", "AppDir"):
            base = os.path.join(tmp, top)
            if os.path.isdir(base):
                got = _copy_res_from(base, rel_paths, dest)
                if got:
                    return got
    return None


def extract_appimage_resources(appimage, cache_dir, config_dir=None, force=False):
    """Retourne le dossier contenant es_systems.xml et es_find_rules.xml,
    extraits de l'AppImage et mis en cache dans cache_dir/resources."""
    cache_res = os.path.join(cache_dir, "resources")
    if not force and cache_is_valid(cache_res, appimage):
        log("ressources en cache : %s" % cache_res)
        return cache_res
    os.makedirs(cache_dir, exist_ok=True)
    rel_paths = []
    from_log = internal_path_from_log(config_dir) if config_dir else None
    if from_log:
        log("chemin interne lu dans es_log.txt : %s" % from_log)
        rel_paths.append(from_log)
    rel_paths += [p for p in INTERNAL_CANDIDATES if p not in rel_paths]

    tmp = tempfile.mkdtemp(prefix="resources.", dir=cache_dir)
    try:
        got = None
        errors = []
        for method in (_extract_by_mount, _extract_by_extract):
            try:
                got = method(appimage, rel_paths, tmp)
            except (LaunchError, OSError, subprocess.SubprocessError) as e:
                errors.append("%s : %s" % (method.__name__, e))
                got = None
            if got:
                break
        if not got:
            raise LaunchError("impossible d'extraire les XML de %s (%s). Utilisez --resources-dir."
                              % (appimage, "; ".join(errors) or "fichiers introuvables"), EXIT_CONFIG)
        m = exe_fingerprint(appimage)
        m["internal_path"] = got
        m["extracted_at"] = datetime.datetime.now().isoformat(timespec="seconds")
        with open(os.path.join(tmp, "manifest.json"), "w", encoding="utf-8") as fh:
            json.dump(m, fh, indent=2)
        if os.path.isdir(cache_res):
            old = cache_res + ".old"
            shutil.rmtree(old, ignore_errors=True)
            os.replace(cache_res, old)
            shutil.rmtree(old, ignore_errors=True)
        os.replace(tmp, cache_res)
        log("XML extraits de l'AppImage (%s) vers %s" % (got, cache_res))
        return cache_res
    finally:
        if os.path.isdir(tmp):
            shutil.rmtree(tmp, ignore_errors=True)


# ==========================================================================
# Contexte : conf + installation + config ES-DE
# ==========================================================================

class Context:
    def __init__(self, conf, config_dir, resources_dir, settings, systems, emulators, cores):
        self.conf = conf
        self.config_dir = config_dir
        self.resources_dir = resources_dir
        self.settings = settings
        self.systems = systems
        self.emulators = emulators
        self.cores = cores

    @property
    def rom_dir(self):
        return self.settings["ROMDirectory"]

    def library_systems(self):
        """Systèmes ayant un gamelist ou un dossier de ROMs non vide."""
        out = []
        for s in self.ordered_systems():
            gl = os.path.join(self.config_dir, "gamelists", s.name, "gamelist.xml")
            if os.path.isfile(gl) or (s.path and os.path.isdir(s.path) and os.listdir(s.path)):
                out.append(s)
        return out

    def ordered_systems(self):
        return sorted(self.systems.values(), key=lambda s: s.order)


def resolve_resources(conf, args, config_dir):
    """Dossier contenant es_systems.xml / es_find_rules.xml, et type d'installation.
    Ordre : option, conf, installation déclarée dans la conf, journal d'ES-DE,
    puis chaque installation détectée (la première exploitable gagne)."""
    refresh = getattr(args, "refresh_cache", False)
    if getattr(args, "resources_dir", None):
        return os.path.abspath(expand(args.resources_dir)), "manual"
    configured = conf.get("install", "resources_dir", "auto")
    kind = conf.get("install", "type", "auto") or "auto"
    if configured and configured != "auto":
        return os.path.abspath(expand(configured)), (kind if kind != "auto" else "manual")
    exe = expand(conf.get("install", "executable"))
    tried = []
    if exe and kind != "auto":
        if not os.path.exists(exe):
            warn("exécutable de la conf introuvable (%s) : détection automatique" % exe)
        elif kind == "appimage" or is_appimage(os.path.realpath(exe)):
            return extract_appimage_resources(exe, conf.cache_dir, config_dir, force=refresh), "appimage"
        else:
            k, _real, res = classify_install(exe)
            if has_resources(res):
                return res, k
            tried.append("%s (%s) : pas de ressources dans %s" % (exe, k, res))
    from_log = resources_from_log(config_dir)
    if from_log:
        log("ressources lues dans es_log.txt : %s" % from_log)
        k = "flatpak" if "/flatpak/" in from_log else "snap" if "/snap/" in from_log else "system"
        return from_log, k
    for c in detect_install():
        if c["type"] == "appimage":
            try:
                return extract_appimage_resources(c["executable"], conf.cache_dir, config_dir,
                                                  force=refresh), "appimage"
            except LaunchError as e:
                tried.append("%s (appimage) : %s" % (c["executable"], e))
        elif c["valid"]:
            return c["resources_dir"], c["type"]
        else:
            tried.append("%s (%s) : pas de ressources dans %s" % (c["executable"], c["type"], c["resources_dir"]))
    detail = ("\n  " + "\n  ".join(tried)) if tried else " aucune installation trouvée"
    raise LaunchError("ressources ES-DE introuvables ; indiquez --resources-dir ou complétez "
                      "[install] dans la conf.%s" % detail, EXIT_CONFIG)


def build_context(conf, args):
    config_dir = os.path.abspath(expand(args.config_dir or conf.get("install", "config_dir") or "~/ES-DE"))
    if not os.path.isdir(config_dir):
        raise LaunchError("dossier de données ES-DE introuvable : %s" % config_dir, EXIT_CONFIG)
    resources, kind = resolve_resources(conf, args, config_dir)
    if kind in SANDBOXED:
        warn("installation %s : les commandes d'ES-DE sont prévues pour son bac à sable ; "
             "le lancement depuis l'hôte peut différer" % kind)
    settings = load_settings(config_dir)
    systems = load_systems(resources, config_dir, settings["ROMDirectory"])
    emulators, cores = load_find_rules(resources, config_dir)
    log("config ES-DE : %s ; ressources : %s ; ROMs : %s" % (config_dir, resources, settings["ROMDirectory"]))
    return Context(conf, config_dir, resources, settings, systems, emulators, cores)


# ==========================================================================
# Génération de la conf (--init)
# ==========================================================================

def generate_conf(path, args, force=False):
    if os.path.exists(path) and not force:
        raise LaunchError("%s existe déjà (utilisez --force)" % path, EXIT_USAGE)
    found = detect_install()
    config_dir = os.path.abspath(expand(args.config_dir)) if args.config_dir else detect_config_dir()
    conf = Conf()
    lines_others = []
    if args.resources_dir:
        conf.cp.set("install", "type", "manual")
        conf.cp.set("install", "resources_dir", args.resources_dir)
    elif found:
        best = found[0]
        if not best["valid"]:
            warn("installation trouvée (%s) mais ressources absentes de %s"
                 % (best["executable"], best["resources_dir"]))
        conf.cp.set("install", "type", best["type"])
        conf.cp.set("install", "executable", best["executable"])
        if best["type"] != "appimage" and best["resources_dir"]:
            conf.cp.set("install", "resources_dir", best["resources_dir"])
        if best["type"] in SANDBOXED:
            lines_others.append("# attention : installation %s, les commandes d'ES-DE visent son bac à sable"
                                % best["type"])
        for other in found[1:]:
            lines_others.append("# autre installation trouvée : %s %s (%s)"
                                % (other["type"], other["executable"] or other["resources_dir"],
                                   "exploitable" if other["valid"] else "sans ressources"))
    else:
        warn("aucune installation ES-DE détectée ; complétez [install] à la main")
        conf.cp.set("install", "type", "manual")
    conf.cp.set("install", "config_dir", config_dir)

    # Priorités : nécessitent la config ES-DE
    try:
        ns = argparse.Namespace(config_dir=config_dir, resources_dir=args.resources_dir, refresh_cache=False)
        ctx = build_context(conf, ns)
        lib = ctx.library_systems()

        def count_games(s):
            g = Gamelist.load(ctx.config_dir, s)
            return len(g.games)
        lib.sort(key=lambda s: (-count_games(s), s.order))
        conf.cp.set("systems", "priority", ", ".join(s.name for s in lib))
        ext_map = {}
        for s in lib:
            for e in s.extensions:
                ext_map.setdefault(e.lstrip(".").lower(), [])
                if s.name not in ext_map[e.lstrip(".").lower()]:
                    ext_map[e.lstrip(".").lower()].append(s.name)
        for e, names in sorted(ext_map.items()):
            if len(names) > 1 and e:
                conf.cp.set("extensions", e, ", ".join(names))
    except LaunchError as e:
        warn("priorités non générées : %s" % e)

    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    if os.path.exists(path):
        shutil.copyfile(path, path + ".bak")
    header = ["# Généré par es-de-launch --init le %s" % datetime.date.today().isoformat(),
              "# [launch] scripts : always | auto (suit CustomEventScripts) | never",
              "# [launch] ambiguity : ask | first | fail",
              "# [extensions] ext = systèmes candidats, du plus au moins prioritaire",
              "# [folders] /chemin/hors/bibliotheque = système",
              "# [mime] type/mime = système"] + lines_others
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(header) + "\n\n")
        conf.cp.write(fh)
    conf.path = path
    return conf


def load_or_init_conf(args):
    path = expand(args.conf) if args.conf else default_conf_path()
    if os.path.isfile(path):
        return Conf.load(path)
    print("es-de-launch : %s absent, détection de l'installation..." % path, file=sys.stderr)
    try:
        conf = generate_conf(path, args)
        print("es-de-launch : configuration écrite dans %s" % path, file=sys.stderr)
        return conf
    except OSError as e:
        warn("impossible d'écrire %s (%s) : configuration en mémoire" % (path, e))
        return Conf()


