# Résolution de l'émulateur et construction de la commande — spec §5
# ==========================================================================

UNQUOTED_SPECIALS = set(" \t\n\"'\\$`!&*()[]{}<>;|?#")


def esc_unquoted(s):
    out = []
    for i, c in enumerate(s):
        if c in UNQUOTED_SPECIALS or (c == "~" and i == 0):
            out.append("\\" + c)
        else:
            out.append(c)
    return "".join(out)


def esc_dquoted(s):
    return re.sub(r'(["$`\\])', r"\\\1", s)


def in_double_quotes(text, idx):
    """Vrai si la position idx est entre guillemets doubles (non échappés)."""
    inside, single, i = False, False, 0
    while i < idx:
        c = text[i]
        if c == "\\" and not single:
            i += 2
            continue
        if c == "'" and not inside:
            single = not single
        elif c == '"' and not single:
            inside = not inside
        i += 1
    return inside


def subst_path(cmd, var, value, raw=False):
    """Remplace %VAR% par value, échappé selon le contexte (guillemets ou non)."""
    token = "%" + var + "%"
    out, pos = [], 0
    while True:
        i = cmd.find(token, pos)
        if i < 0:
            out.append(cmd[pos:])
            break
        out.append(cmd[pos:i])
        if raw:
            out.append(value)
        elif in_double_quotes(cmd, i):
            out.append(esc_dquoted(value))
        else:
            out.append(esc_unquoted(value))
        pos = i + len(token)
    return "".join(out)


class Resolved:
    def __init__(self):
        self.command = ""
        self.cwd = None
        self.label = ""
        self.label_reason = ""
        self.emulator_path = None
        self.run_in_background = False
        self.notes = []


def find_emulator(ctx, name):
    """Applique les règles de recherche. Retourne (chemin, commande_alternative, règles_testées)."""
    rules = ctx.emulators.get(name)
    tried = []
    if rules is None:
        raise LaunchError("émulateur %s absent de es_find_rules.xml" % name, EXIT_EMULATOR)
    for rtype, entries in rules:
        for entry in entries:
            tried.append("%s:%s" % (rtype, entry))
            if rtype == "systempath":
                p = shutil.which(entry)
                if p:
                    return p, None, tried
            elif rtype == "staticpath":
                path, _, alt = entry.partition("|")
                for p in sorted(glob.glob(expand(path))):
                    if os.path.isfile(p) and os.access(p, os.X_OK):
                        return p, (alt.strip() or None), tried
    return None, None, tried


def find_core_dir(ctx, name, core_file):
    rules = ctx.cores.get(name, [])
    tried = []
    for rtype, entries in rules:
        if rtype != "corepath":
            continue
        for entry in entries:
            d = expand(entry)
            tried.append(d)
            if os.path.isfile(os.path.join(d, core_file)):
                return d, tried
    return None, tried


def choose_command(ctx, system, rom, forced_label=None):
    """Spec §5 : --emulator > altemulator du jeu > alternativeEmulator du système > 1re commande."""
    if not system.commands:
        raise LaunchError("le système %s n'a aucune commande" % system.name, EXIT_EMULATOR)
    labels = {label: cmd for label, cmd in system.commands}
    gl = Gamelist.load(ctx.config_dir, system)
    game = gl.game(rom) or {}
    steps = [
        (forced_label, "--emulator"),
        (game.get("altemulator"), "émulateur alternatif du jeu (gamelist)"),
        (gl.alt_emulator, "émulateur alternatif du système (gamelist)"),
    ]
    for label, reason in steps:
        if not label:
            continue
        if label in labels:
            return label, labels[label], reason, gl, game
        if reason == "--emulator":
            raise LaunchError("émulateur %r inconnu pour %s ; disponibles : %s"
                              % (label, system.name, ", ".join(labels)), EXIT_EMULATOR)
        warn("%s %r absent de es_systems.xml, repli" % (reason, label))
    label, cmd = system.commands[0]
    return label, cmd, "émulateur par défaut (1re commande)", gl, game


def parse_desktop_exec(path):
    """Ligne Exec= (et Path=) d'un fichier .desktop, codes de champ retirés."""
    exec_line, workdir, in_entry = None, None, False
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if line.startswith("["):
                in_entry = line == "[Desktop Entry]"
                continue
            if not in_entry:
                continue
            if line.startswith("Exec=") and exec_line is None:
                exec_line = line[5:]
            elif line.startswith("Path=") and workdir is None:
                workdir = line[5:]
    if exec_line is None:
        raise LaunchError("pas de ligne Exec= dans %s" % path, EXIT_EMULATOR)
    exec_line = re.sub(r"%[fFuUdDnNickvm]", "", exec_line).replace("%%", "%").strip()
    return exec_line, (workdir or None)


KNOWN_LITERALS = {"RPCS3_GAMEID"}  # passé tel quel à RPCS3 (syntaxe %RPCS3_GAMEID%:SERIE)


def build_command(ctx, system, rom, forced_label=None):
    res = Resolved()
    label, cmd, reason, _gl, _game = choose_command(ctx, system, rom, forced_label)
    res.label, res.label_reason = label, reason
    log("commande retenue : %s (%s) : %s" % (label, reason, cmd))
    if cmd.startswith("PLACEHOLDER"):
        raise LaunchError("le système %s n'est pas lançable sous Linux (commande PLACEHOLDER)"
                          % system.name, EXIT_EMULATOR)

    rom = os.path.abspath(rom)
    gamedir = os.path.dirname(rom)
    filename = os.path.basename(rom.rstrip("/"))
    basename = os.path.splitext(filename)[0]

    # Marqueurs
    for flag in ("%HIDEWINDOW%", "%ESCAPESPECIALS%"):
        cmd = cmd.replace(flag + " ", "").replace(flag, "")
    if "%RUNINBACKGROUND%" in cmd:
        res.run_in_background = True
        cmd = cmd.replace("%RUNINBACKGROUND% ", "").replace("%RUNINBACKGROUND%", "")
    shortcuts = "%ENABLESHORTCUTS%" in cmd
    cmd = cmd.replace("%ENABLESHORTCUTS% ", "").replace("%ENABLESHORTCUTS%", "")

    if shortcuts and rom.lower().endswith(".desktop"):
        exec_line, workdir = parse_desktop_exec(rom)
        res.command = exec_line
        res.cwd = expand(workdir) if workdir else gamedir
        res.notes.append("raccourci .desktop : ligne Exec= exécutée")
        return res

    def simple_vars(text, raw_ok=True):
        text = text.replace("%BASENAME%", basename).replace("%FILENAME%", filename)
        text = text.replace("%GAMEDIR%", gamedir).replace("%GAMEDIRRAW%", gamedir)
        text = text.replace("%ROMPATH%", ctx.rom_dir).replace("%GAMEENTRYDIR%", rom)
        return text

    # %STARTDIR%=valeur
    m = re.search(r"%STARTDIR%=(\S+)\s*", cmd)
    startdir_raw = None
    if m:
        startdir_raw = m.group(1)
        cmd = cmd[:m.start()] + cmd[m.end():]

    # %INJECT%=fichier
    def inject(mm):
        fname = simple_vars(mm.group(1))
        p = fname if os.path.isabs(fname) else os.path.join(gamedir, fname)
        if os.path.isfile(p) and os.path.getsize(p) <= 4096:
            with open(p, encoding="utf-8", errors="replace") as fh:
                content = " ".join(fh.read().split())
            res.notes.append("injecté depuis %s" % p)
            return content
        return ""
    cmd = re.sub(r"%INJECT%=(\S+)", inject, cmd)

    # %EMULATOR_X%
    emudir = None
    for mm in list(re.finditer(r"%EMULATOR_([A-Za-z0-9_!.\-]+)%", cmd)):
        name = mm.group(1)
        path, alt, tried = find_emulator(ctx, name)
        if not path:
            raise LaunchError("émulateur %s introuvable. Règles testées :\n  %s"
                              % (name, "\n  ".join(tried)), EXIT_EMULATOR)
        log("émulateur %s : %s" % (name, path))
        res.emulator_path = path
        emudir = os.path.dirname(path)
        repl = alt if alt else esc_unquoted(path)
        cmd = cmd.replace(mm.group(0), repl, 1)

    # %PRECOMMAND_X%
    for mm in list(re.finditer(r"%PRECOMMAND_([A-Za-z0-9_!.\-]+)%", cmd)):
        path, alt, tried = find_emulator(ctx, mm.group(1))
        if not path:
            raise LaunchError("pré-commande %s introuvable. Règles testées :\n  %s"
                              % (mm.group(1), "\n  ".join(tried)), EXIT_EMULATOR)
        cmd = cmd.replace(mm.group(0), alt or esc_unquoted(path), 1)

    # %CORE_X%/fichier
    def core(mm):
        name, core_file = mm.group(1), mm.group(2)
        d, tried = find_core_dir(ctx, name, core_file)
        if not d:
            raise LaunchError("cœur %s introuvable. Dossiers testés :\n  %s"
                              % (core_file, "\n  ".join(tried)), EXIT_EMULATOR)
        log("cœur : %s/%s" % (d, core_file))
        return esc_unquoted(d) + "/" + core_file
    cmd = re.sub(r"%CORE_([A-Za-z0-9_!.\-]+)%/(\S+)", core, cmd)

    # chemins
    winpath = "Z:" + rom.replace("/", "\\")
    cmd = subst_path(cmd, "ROMRAWWIN", winpath, raw=True)
    cmd = subst_path(cmd, "ROMRAW", rom, raw=True)
    cmd = subst_path(cmd, "GAMEDIRRAW", gamedir, raw=True)
    cmd = subst_path(cmd, "ROM", rom)
    cmd = subst_path(cmd, "GAMEDIR", gamedir)
    cmd = subst_path(cmd, "GAMEENTRYDIR", rom)
    cmd = subst_path(cmd, "ROMPATH", ctx.rom_dir)
    cmd = subst_path(cmd, "BASENAME", basename)
    cmd = subst_path(cmd, "FILENAME", filename)
    if "%EMUDIR%" in cmd:
        if not emudir:
            raise LaunchError("%EMUDIR% sans émulateur résolu", EXIT_EMULATOR)
        cmd = subst_path(cmd, "EMUDIR", emudir)
    if "%ESPATH%" in cmd:
        warn("%ESPATH% désigne le dossier d'ES-DE, qui peut être un montage temporaire (AppImage)")
        cmd = subst_path(cmd, "ESPATH", "")

    leftover = [v for v in re.findall(r"%([A-Z][A-Z0-9_!\-]*)%", cmd) if v not in KNOWN_LITERALS]
    if leftover:
        raise LaunchError("variable(s) ES-DE non gérée(s) : %s" % ", ".join("%" + v + "%" for v in leftover))

    if startdir_raw:
        sd = startdir_raw.replace("%GAMEDIR%", gamedir).replace("%GAMEENTRYDIR%", rom)
        if "%EMUDIR%" in sd:
            sd = sd.replace("%EMUDIR%", emudir or "")
        res.cwd = expand(sd)
    res.command = cmd.strip()
    return res


# ==========================================================================
# Exécution et scripts — spec §6
# ==========================================================================

def scripts_enabled(ctx, args):
    if args.no_scripts:
        return False
    if args.scripts:
        return True
    mode = ctx.conf.get("launch", "scripts", "always")
    if mode == "never":
        return False
    if mode == "auto":
        return bool(ctx.settings.get("CustomEventScripts"))
    return True


def event_scripts(ctx, event):
    d = os.path.join(ctx.config_dir, "scripts", event)
    if not os.path.isdir(d):
        return []
    out = []
    for f in sorted(os.listdir(d)):
        p = os.path.join(d, f)
        if os.path.isfile(p):
            if os.access(p, os.X_OK):
                out.append(p)
            else:
                log("script non exécutable ignoré : %s" % p)
    return out


def run_scripts(ctx, event, script_args, env):
    for s in event_scripts(ctx, event):
        log("script %s : %s" % (event, s))
        try:
            rc = subprocess.call([s] + script_args, env=env)
            if rc != 0:
                warn("le script %s s'est terminé avec le code %d" % (s, rc))
        except OSError as e:
            warn("échec du script %s : %s" % (s, e))


def game_name(gl_game, rom):
    if gl_game and gl_game.get("name"):
        return gl_game["name"]
    return os.path.splitext(os.path.basename(rom.rstrip("/")))[0]


def launch(ctx, args, system, rom, det, res):
    cache = ctx.conf.cache_dir
    os.makedirs(cache, exist_ok=True)
    lock_fh = open(os.path.join(cache, "lock"), "w")
    try:
        fcntl.flock(lock_fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock_fh.close()
        raise LaunchError("un autre lancement est en cours (verrou %s)" % os.path.join(cache, "lock"))

    gl = Gamelist.load(ctx.config_dir, system)
    name = game_name(gl.game(rom), rom)
    script_args = [os.path.abspath(rom), name, system.name, system.fullname]
    env = dict(os.environ)
    env.update({"ESDE_LAUNCHER": "es-de-launch", "ESDE_SYSTEM": system.name,
                "ESDE_EMULATOR_LABEL": res.label, "ESDE_DETECTION_METHOD": det.method})
    use_scripts = scripts_enabled(ctx, args)
    logpath = os.path.join(cache, "last_run.log")
    rc = EXIT_ERROR
    proc = None

    def forward(signum, _frame):
        if proc and proc.poll() is None:
            try:
                os.killpg(proc.pid, signum)
            except OSError:
                pass

    old = {s: signal.signal(s, forward) for s in (signal.SIGINT, signal.SIGTERM)}
    try:
        if use_scripts:
            run_scripts(ctx, "game-start", script_args, env)
        log("lancement : %s (dossier : %s)" % (res.command, res.cwd or os.getcwd()))
        with open(logpath, "w", encoding="utf-8") as logfh:
            logfh.write("# %s\n# cwd: %s\n# %s\n" % (datetime.datetime.now().isoformat(timespec="seconds"),
                                                     res.cwd or os.getcwd(), res.command))
            logfh.flush()
            out = None if VERBOSE else logfh
            try:
                proc = subprocess.Popen(["/bin/sh", "-c", res.command], cwd=res.cwd or None,
                                        stdout=out, stderr=out, env=env, start_new_session=True)
            except OSError as e:
                raise LaunchError("échec du lancement : %s" % e, EXIT_EMULATOR)
            while True:
                try:
                    rc = proc.wait()
                    break
                except InterruptedError:
                    continue
    finally:
        if use_scripts:
            run_scripts(ctx, "game-end", script_args, env)
        for s, h in old.items():
            signal.signal(s, h)
        lock_fh.close()
    return rc if rc >= 0 else 128 - rc


