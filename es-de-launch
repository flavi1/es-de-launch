def print_detection(args):
    found = detect_install()
    config_dir = os.path.abspath(expand(args.config_dir)) if args.config_dir else detect_config_dir()
    from_log = resources_from_log(config_dir)
    if args.json:
        print(json.dumps({"config_dir": config_dir, "resources_from_log": from_log, "installs": found},
                         indent=2, ensure_ascii=False))
        return EXIT_OK if found or from_log else EXIT_CONFIG
    print("Données ES-DE    : %s%s" % (config_dir, "" if os.path.isdir(config_dir) else " (absent)"))
    if from_log:
        print("Ressources (log) : %s" % from_log)
    if not found:
        print("Aucune installation ES-DE détectée.")
        return EXIT_OK if from_log else EXIT_CONFIG
    for i, c in enumerate(found):
        mark = "*" if i == 0 else " "
        res = c["resources_dir"] or "dans l'AppImage (extraites en cache)"
        print("%s %-9s %s" % (mark, c["type"], c["executable"] or "-"))
        print("    réel       : %s" % c["real"])
        print("    ressources : %s%s" % (res, "" if c["valid"] else " (absentes)"))
        print("    trouvé par : %s" % c["origin"])
    print("* = installation retenue par défaut")
    return EXIT_OK


def build_parser():
    p = argparse.ArgumentParser(prog="es-de-launch",
                                description="Lance un jeu comme le ferait le menu d'ES-DE.")
    p.add_argument("file", nargs="?", metavar="FICHIER", help="ROM ou jeu à lancer")
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--info", action="store_true", help="affiche les informations sur la ROM")
    mode.add_argument("--copy", action="store_true", help="range la ROM dans la bibliothèque")
    mode.add_argument("--output-cmd", action="store_true", help="affiche la commande sans la lancer")
    mode.add_argument("--init", action="store_true", help="détecte l'installation et génère la conf")
    mode.add_argument("--show-conf", action="store_true", help="affiche la conf effective")
    mode.add_argument("--detect-install", action="store_true",
                      help="liste les installations ES-DE détectées, sans rien écrire")
    p.add_argument("--conf", help="fichier de conf (défaut : ~/.config/es-de-launch.conf)")
    p.add_argument("--config-dir", help="dossier de données ES-DE (défaut : ~/ES-DE)")
    p.add_argument("--resources-dir", help="dossier contenant es_systems.xml et es_find_rules.xml")
    p.add_argument("--system", help="force le système")
    p.add_argument("--emulator", help="force une commande (label) du système")
    sc = p.add_mutually_exclusive_group()
    sc.add_argument("--scripts", action="store_true", help="force l'exécution des scripts")
    sc.add_argument("--no-scripts", action="store_true", help="n'exécute pas les scripts")
    p.add_argument("--json", action="store_true", help="sortie JSON (--info, --output-cmd)")
    p.add_argument("--move", action="store_true", help="avec --copy : déplace")
    p.add_argument("--dry-run", action="store_true", help="avec --copy : n'écrit rien")
    p.add_argument("--overwrite", action="store_true", help="avec --copy : écrase")
    p.add_argument("--rename", action="store_true", help="avec --copy : suffixe ' (1)' en cas de conflit")
    p.add_argument("--fix-ext", action="store_true", help="avec --copy : corrige l'extension")
    p.add_argument("--force", action="store_true", help="avec --init : remplace la conf existante")
    p.add_argument("--refresh-cache", action="store_true", help="réextrait les XML de l'AppImage")
    p.add_argument("-y", "--yes", action="store_true", help="aucune question interactive")
    p.add_argument("-v", "--verbose", action="store_true", help="trace la résolution")
    p.add_argument("--version", action="version", version="es-de-launch " + VERSION)
    return p


def main(argv=None):
    global VERBOSE
    args = build_parser().parse_args(argv)
    VERBOSE = args.verbose
    try:
        if args.init:
            path = expand(args.conf) if args.conf else default_conf_path()
            generate_conf(path, args, force=args.force)
            print("Configuration écrite dans %s" % path)
            return EXIT_OK
        if args.detect_install:
            return print_detection(args)
        conf = load_or_init_conf(args)
        if args.show_conf:
            conf.cp.write(sys.stdout)
            return EXIT_OK
        if not args.file:
            print("es-de-launch : FICHIER manquant", file=sys.stderr)
            return EXIT_USAGE
        rom = os.path.abspath(expand(args.file))
        if not os.path.exists(rom):
            raise LaunchError("fichier introuvable : %s" % rom, EXIT_USAGE)
        ctx = build_context(conf, args)

        if args.info:
            data, code = info(ctx, args, rom)
            if args.json:
                print(json.dumps(data, indent=2, ensure_ascii=False))
            else:
                print_info(data)
            return code
        if args.copy:
            return copy_rom(ctx, args, rom)

        det = detect_system(ctx, rom, args.system, assume_yes=args.yes)
        for w in det.warnings:
            warn(w)
        system = ctx.systems[det.system]
        log("système : %s (%s)" % (system.name, det.method))
        res = build_command(ctx, system, rom, args.emulator)

        if args.output_cmd:
            if args.json:
                print(json.dumps({
                    "cwd": res.cwd, "command": res.command, "shell_command": res.shell_command,
                    "run_in_background": res.run_in_background, "system": system.name,
                    "emulator_label": res.label, "detection": det.method,
                    "scripts": {"start": event_scripts(ctx, "game-start") if scripts_enabled(ctx, args) else [],
                                "end": event_scripts(ctx, "game-end") if scripts_enabled(ctx, args) else []},
                }, indent=2, ensure_ascii=False))
            else:
                print(res.shell_command)
            return EXIT_OK
        return launch(ctx, args, system, rom, det, res)
    except LaunchError as e:
        print("es-de-launch : %s" % e, file=sys.stderr)
        return e.code
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
