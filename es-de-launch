# ---- Lecteurs : fichier brut ou image PSP .cso décompressée à la demande ----

HEAD_SIZE = 0x10400  # couvre l'en-tête SNES HiROM avec en-tête de copieur


class FileReader:
    def __init__(self, fh, size):
        self.fh, self.size = fh, size

    def read(self, offset, n):
        if offset < 0 or offset >= self.size:
            return b""
        self.fh.seek(offset)
        return self.fh.read(n)


class CsoReader:
    """Image PSP .cso (CISO v1/v2, blocs deflate). Lecture du contenu ISO décompressé."""

    def __init__(self, fh):
        h = read_at(fh, 0, 24)
        if h[:4] != b"CISO" or struct.unpack("<I", h[4:8])[0] not in (0, 0x18):
            raise ValueError("pas un CSO")
        self.fh = fh
        self.size = struct.unpack("<Q", h[8:16])[0]
        self.bs = struct.unpack("<I", h[16:20])[0]
        self.align = h[21]
        if not self.bs or not self.size:
            raise ValueError("CSO vide")

    def _block(self, n):
        a, b = struct.unpack("<II", read_at(self.fh, 24 + 4 * n, 8))
        pos, end = (a & 0x7FFFFFFF) << self.align, (b & 0x7FFFFFFF) << self.align
        raw = read_at(self.fh, pos, end - pos)
        if a & 0x80000000:
            return raw[:self.bs]
        return zlib.decompressobj(-15).decompress(raw)[:self.bs]

    def read(self, offset, n):
        out = b""
        while n > 0 and 0 <= offset < self.size:
            data = self._block(offset // self.bs)[offset % self.bs:][:n]
            if not data:
                break
            out += data
            offset += len(data)
            n -= len(data)
        return out


# ---- ISO 9660 minimal --------------------------------------------------------

def _iso_layout(rd):
    """(taille de secteur, décalage des données) si un volume ISO9660 est trouvé."""
    for sector, data_off in ((2048, 0), (2352, 24), (2352, 16)):
        if rd.read(16 * sector + data_off + 1, 5) == b"CD001":
            return sector, data_off
    return None


def _iso_sector(rd, layout, lba, count=1):
    sector, off = layout
    return b"".join(rd.read((lba + i) * sector + off, 2048) for i in range(count))


def iso_info(rd):
    """Volume principal et répertoire racine : {'system_id', 'volume_id', 'files': {NOM: (lba, taille)}}."""
    layout = _iso_layout(rd)
    if not layout:
        return None
    pvd = _iso_sector(rd, layout, 16)
    root = pvd[156:156 + 34]
    lba = struct.unpack("<I", root[2:6])[0]
    size = struct.unpack("<I", root[10:14])[0]
    data = _iso_sector(rd, layout, lba, max(1, min(16, (size + 2047) // 2048)))
    files, i = {}, 0
    while i < len(data):
        ln = data[i]
        if ln == 0:
            i = ((i // 2048) + 1) * 2048
            continue
        rec = data[i:i + ln]
        if len(rec) < 34:
            break
        name = rec[33:33 + rec[32]].decode("ascii", "replace").split(";")[0].upper()
        files[name] = (struct.unpack("<I", rec[2:6])[0], struct.unpack("<I", rec[10:14])[0])
        i += ln
    return {"layout": layout, "files": files,
            "system_id": pvd[8:40].decode("ascii", "replace").strip(),
            "volume_id": pvd[40:72].decode("ascii", "replace").strip()}


def sniff_iso(rd):
    info = iso_info(rd)
    if info is None:
        return None
    files = info["files"]
    if info["system_id"].startswith("PSP GAME") or "PSP_GAME" in files or "UMD_DATA.BIN" in files:
        return (CERTAIN, ["psp"], "ISO9660 : PSP GAME")
    if "PS3_GAME" in files or "PS3_DISC.SFB" in files:
        return (CERTAIN, ["ps3"], "ISO9660 : PS3_GAME")
    if "SYSTEM.CNF" in files:
        f_lba, f_size = files["SYSTEM.CNF"]
        cnf = _iso_sector(rd, info["layout"], f_lba)[:min(f_size, 2048)].decode("ascii", "replace")
        if re.search(r"^\s*BOOT2\s*=", cnf, re.M):
            return (CERTAIN, ["ps2"], "SYSTEM.CNF : BOOT2")
        if re.search(r"^\s*BOOT\s*=", cnf, re.M):
            return (CERTAIN, ["psx"], "SYSTEM.CNF : BOOT")
    if "IPL.TXT" in files:
        return (CERTAIN, ["neogeocd"], "ISO9660 : IPL.TXT (Neo Geo CD)")
    if info["system_id"].startswith("PLAYSTATION"):
        return (PROBABLE, ["psx", "ps2"], "ISO9660 : système PLAYSTATION")
    return None


