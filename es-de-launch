ESCAPED_CHARS = "\\ '\"!$^&*(){}[]?;<>"


def es_escape(path):
    """getEscapedPath() : barre oblique inverse devant \\ ' " ! $ ^ & * ( ) { } [ ] ? ; < >
    et l'espace, sauf si le caractère est déjà précédé d'une barre oblique inverse."""
    s = path
    for ch in ESCAPED_CHARS:
        start = 0
        while True:
            off = s.find(ch, start)
            if off < 0:
                break
            start = off + 1
            if off == 0 or s[off - 1] != "\\":
                s = s[:off] + "\\" + s[off:]
                start += 1
    return s


def es_extension(path):
    """getExtension() : depuis le dernier point du nom, ou « . » s'il n'y en a pas."""
    name = os.path.basename(path.rstrip("/"))
    i = name.rfind(".")
    return name[i:] if i >= 0 else "."


def es_stem(path):
    """getStem() : nom sans extension ; un dossier garde son nom complet."""
    name = os.path.basename(path.rstrip("/"))
    if os.path.isdir(path):
        return name
    i = name.rfind(".")
    return name[:i] if i >= 0 else name


def es_parent(path):
    """getParent() sur une chaîne."""
    path = path.rstrip("/") if path != "/" else path
    i = path.rfind("/")
    if i < 0:
        return ""
    return path[:i] if i > 0 else "/"


def path_to_binary(name):
    """getPathToBinary() : premier dossier du PATH contenant un fichier ou un lien de ce nom
    (le bit d'exécution n'est pas vérifié)."""
    for d in (os.environ.get("PATH") or "").split(":"):
        if not d:
            continue
        p = d + "/" + name
        if os.path.isfile(p) or os.path.islink(p):
            return d
    return ""


def matching_files(pattern):
    """getMatchingFiles() : * uniquement dans le nom de fichier, ordre de lecture du dossier."""
    entry = pattern.find("*")
    if entry < 0:
        return []
    parent = es_parent(pattern)
    if entry <= len(parent) or not os.path.isdir(parent):
        return []
    rx = pattern.replace("*", ".*").replace(")", "\\)").replace("(", "\\(").replace("]", "\\]").replace("[", "\\[")
    try:
        expr = re.compile(rx)
    except re.error:
        return []
    out = []
    for name in os.listdir(parent):
        full = parent.rstrip("/") + "/" + name
        if expr.fullmatch(full):
            out.append(full)
    return out


FOUND, NOT_FOUND, NO_RULES = "found", "not_found", "no_rules"


def find_emulator(ctx, command, pre_command=False):
    """findEmulator() : (commande modifiée, exécutable, statut, nom de l'entrée, règles testées)."""
    key = "%PRECOMMAND_" if pre_command else "%EMULATOR_"
    start = command.find(key)
    end = command.find("%", start + 1) if start >= 0 else -1
    entry = command[start + len(key):end] if start >= 0 and end >= 0 else ""
    tried = []
    if entry:
        rules = ctx.emulators.get(entry, {"systempath": [], "staticpath": []})
        if not rules["systempath"] and not rules["staticpath"]:
            return command, entry, NO_RULES, entry, tried
        for name in rules["systempath"]:
            tried.append("systempath:" + name)
            d = path_to_binary(name)
            if d:
                exe = d + "/" + name
                return command[:start] + exe + command[end + 1:], exe, FOUND, entry, tried
        for raw in rules["staticpath"]:
            tried.append("staticpath:" + raw)
            path, sep, replace_cmd = raw.partition("|")
            path = expand_home(path, ctx.home_dir)
            path = path.replace("%ESPATH%", ctx.es_path).replace("%ROMPATH%", ctx.rom_dir)
            if "*" in path:
                files = matching_files(path)
                if files:
                    path = files[0]
            if os.path.isfile(path) or os.path.islink(path):
                exe = replace_cmd if replace_cmd else es_escape(path)
                return command[:start] + exe + command[end + 1:], exe, FOUND, entry, tried
    # Méthode 2 : nom d'exécutable explicite (premier mot de la commande).
    command = command.replace("%ESPATH%", ctx.es_path)
    if command.startswith('"'):
        exe_name = command[1:].split('"')[0]
    else:
        exe_name = command.split(" ")[0]
    if "*" in exe_name:
        files = matching_files(exe_name)
        if files:
            command = command.replace(exe_name, files[0])
            exe_name = files[0]
    exe = ""
    if exe_name and (os.path.isfile(exe_name) or os.path.islink(exe_name)):
        exe = es_escape(exe_name)
    elif exe_name:
        d = path_to_binary(exe_name)
        if d:
            exe = es_escape(d) + "/" + exe_name
    tried.append("commande : " + exe_name)
    return command, exe, (FOUND if exe else NOT_FOUND), (entry or exe_name), tried


class Resolved:
    def __init__(self):
        self.command = ""          # « Expanded emulator launch command » du journal d'ES-DE
        self.cwd = None            # %STARTDIR% ou Path= du .desktop (non échappé)
        self.label = ""
        self.label_reason = ""
        self.emulator_path = None
        self.rom_path = ""         # 1er argument des scripts (chemin échappé, ou Exec= d'un .desktop)
        self.run_in_background = False
        self.notes = []

    @property
    def shell_command(self):
        """Ce que launchGameUnix() exécute, sans le « 2>&1 & » final."""
        if self.cwd:
            return "cd " + es_escape(self.cwd) + " && " + self.command
        return self.command


def choose_command(ctx, system, rom, forced_label=None):
    """Émulateur alternatif du jeu (si AlternativeEmulatorPerGame), sinon du système,
    sinon la première commande. Une étiquette invalide renvoie à la commande par défaut."""
    if not system.commands:
        raise LaunchError("le système %s n'a aucune commande" % system.name, EXIT_EMULATOR)
    gl = Gamelist.load(ctx, system)
    game = gl.game(rom) or {}
    default_label, default_cmd = system.commands[0]
    if forced_label:
        cmd = system.command_for(forced_label)
        if not cmd:
            raise LaunchError("émulateur %r inconnu pour %s ; disponibles : %s"
                              % (forced_label, system.name, ", ".join(l for l, _ in system.commands)),
                              EXIT_EMULATOR)
        return forced_label, cmd, "--emulator", gl, game
    if ctx.settings.get("AlternativeEmulatorPerGame") and game.get("altemulator"):
        label = game["altemulator"]
        cmd = system.command_for(label)
        if cmd:
            return label, cmd, "émulateur alternatif du jeu (gamelist)", gl, game
        warn("émulateur alternatif %r du jeu invalide : émulateur par défaut, comme ES-DE" % label)
    elif gl.alt_emulator:
        return gl.alt_emulator, system.command_for(gl.alt_emulator), \
            "émulateur alternatif du système (gamelist)", gl, game
    elif gl.alt_emulator_invalid:
        warn("émulateur alternatif %r du système invalide : émulateur par défaut, comme ES-DE"
             % gl.alt_emulator_invalid)
    return default_label, default_cmd, "émulateur par défaut (1re commande)", gl, game


DESKTOP_FIELD_CODES = "fFuUdDnNickvm"


def strip_field_codes(text):
    """Retire les codes %f, %U… précédés d'un caractère autre que %, puis %% -> %."""
    for code in reversed(DESKTOP_FIELD_CODES):
        rx = re.compile("[^%]%" + code)
        while True:
            m = rx.search(text)
            if not m:
                break
            text = text[:m.start() + 1] + text[m.end():]
    return text.replace("%%", "%").strip()


def _quoted_value(command, pos, var_len, what):
    """Valeur de %VAR%=valeur ou %VAR%="valeur" (validité déjà vérifiée par l'appelant) ;
    retourne (valeur, commande sans la variable), comme ES-DE."""
    first = pos + var_len + 1
    if command[first] == '"':
        close = command.find('"', first + 1)
        if close < 0:
            raise LaunchError("entrée %%%s%% invalide (guillemet non fermé)" % what, EXIT_EMULATOR)
        return command[first + 1:close], command[:pos] + command[close + 2:]
    sp = command.find(" ", pos)
    if sp >= 0:
        return command[first:sp], command[:pos] + command[sp + 1:]
    return command[first:], command[:pos]


def build_command(ctx, system, rom, forced_label=None):
    res = Resolved()
    label, command, reason, _gl, _game = choose_command(ctx, system, rom, forced_label)
    res.label, res.label_reason = label, reason
    command_raw = command
    log("commande retenue : %s (%s) : %s" % (label, reason, command_raw))

    rom = os.path.abspath(rom).rstrip("/") or "/"
    rom_path = es_escape(rom)
    base_name = es_stem(rom)
    rom_raw = rom
    rom_raw_win = rom.replace("/", "\\")
    # Dossier interprété comme fichier : un fichier du même nom à l'intérieur est lancé.
    if os.path.isdir(rom):
        for name in os.listdir(rom):
            f = rom + "/" + name
            if name == os.path.basename(rom) and (os.path.isfile(f) or os.path.islink(f)):
                rom_path = es_escape(f)
                base_name = base_name.split(".")[0]
                break
    file_name = base_name + es_extension(rom_path)

    if "%RUNINBACKGROUND%" in command:
        res.run_in_background = True
        command = command.replace("%RUNINBACKGROUND%", "").lstrip()
    if ctx.settings.get("RunInBackground"):
        res.run_in_background = True

    is_shortcut = False
    if "%ENABLESHORTCUTS%" in command:
        is_shortcut = es_extension(rom_raw) == ".desktop"
        command = command.replace("%ENABLESHORTCUTS%", "").lstrip()

    has_core_quote = '"%CORE_' in command
    if has_core_quote:
        command = command.replace('"%CORE_', "%CORE_")
    core_entry = ""
    pos = command.find("%CORE_")
    if pos >= 0:
        end = command.find("%", pos + 6)
        if end >= 0:
            core_entry = command[pos + 6:end]
    core_paths = ctx.cores.get(core_entry, {}).get("corepath", []) if core_entry else []

    command = expand_home(command, ctx.home_dir)

    if "%PRECOMMAND_" in command:
        command, pre, status, name, tried = find_emulator(ctx, command, pre_command=True)
        if status == NO_RULES:
            raise LaunchError("aucune règle de recherche pour la pré-commande %s" % name, EXIT_EMULATOR)
        if status == NOT_FOUND:
            raise LaunchError("pré-commande %s introuvable. Règles testées :\n  %s"
                              % (name, "\n  ".join(tried)), EXIT_EMULATOR)

    command, emulator, status, name, tried = find_emulator(ctx, command)
    if status == NO_RULES:
        raise LaunchError("aucune règle de recherche pour l'émulateur %s dans es_find_rules.xml" % name,
                          EXIT_EMULATOR)
    if status == NOT_FOUND:
        if command_raw.strip().startswith("PLACEHOLDER"):
            raise LaunchError("le système %s n'est pas lançable sous Linux (commande PLACEHOLDER)"
                              % system.name, EXIT_EMULATOR)
        raise LaunchError("émulateur %s introuvable. Règles testées :\n  %s"
                          % (name, "\n  ".join(tried)), EXIT_EMULATOR)
    res.emulator_path = emulator
    log("émulateur : %s" % emulator)

    # %EMUPATH% : chemin d'un cœur relatif au dossier de l'émulateur (ancienne méthode).
    pos = command.find("%EMUPATH%")
    if pos >= 0:
        quoted = pos > 0 and command[pos - 1] == '"'
        qpos = (command.find('"', pos + 9) - pos) if quoted else 0
        sp = command.find(" ", pos + qpos)
        if sp < 0:
            raise LaunchError("entrée %EMUPATH% invalide", EXIT_EMULATOR)
        core_raw = command[pos:sp]
        core_file = es_parent(emulator) + command[pos + 9:sp]
        if quoted:
            core_raw, core_file = core_raw[:-1], core_file[:-1]
        if not (os.path.isfile(core_file) or os.path.islink(core_file)):
            raise LaunchError("fichier de cœur %s introuvable" % os.path.basename(core_file), EXIT_EMULATOR)
        if quoted:
            command = command[:pos + qpos] + command[pos + qpos + 1:]
            pos -= 1
            command = command[:pos] + command[pos + 1:]
        command = command[:pos] + es_escape(core_file) + command[pos + len(core_raw):]

    if core_entry and not core_paths:
        raise LaunchError("aucune règle corepath pour le cœur %s dans es_find_rules.xml" % core_entry,
                          EXIT_EMULATOR)
    found_core, core_name = False, ""
    for path in core_paths:
        pos = command.find("%CORE_")
        end = command.find("%", pos + 6)
        qpos = command.find('"', end) if has_core_quote else -1
        sep = qpos if qpos >= 0 else command.find(" ", end)
        if sep < 0:
            raise LaunchError("entrée %CORE_ invalide dans es_systems.xml", EXIT_EMULATOR)
        core_name = command[end + 2:sep]
        core_file = expand_home(path + "/" + core_name, ctx.home_dir)
        core_file = core_file.replace("%EMUPATH%", es_parent(emulator)).replace("%ESPATH%", ctx.es_path)
        if os.path.isfile(core_file) or os.path.islink(core_file):
            found_core = True
            if " " in core_file:
                core_file = es_escape(core_file)
            command = command[:pos] + core_file + command[sep + (1 if has_core_quote else 0):]
            log("cœur : %s" % core_file)
            break
    if not found_core and core_name:
        raise LaunchError("cœur %s introuvable. Dossiers testés :\n  %s"
                          % (core_name, "\n  ".join(core_paths)), EXIT_EMULATOR)

    start_dir = ""
    pos = command.find("%STARTDIR%")
    if pos >= 0:
        if pos + 12 >= len(command) or command[pos + 10] != "=":
            raise LaunchError("entrée %STARTDIR% invalide", EXIT_EMULATOR)
        start_dir, command = _quoted_value(command, pos, 10, "STARTDIR")
        if start_dir:
            start_dir = expand_home(start_dir, ctx.home_dir)
            start_dir = start_dir.replace("%EMUDIR%", es_parent(emulator.replace("\\", "")))
            start_dir = start_dir.replace("%GAMEDIR%", es_parent(rom_path.replace("\\", "")))
            start_dir = start_dir.replace("%GAMEENTRYDIR%", rom_path.replace("\\", ""))

    pos = command.find("%INJECT%")
    while pos >= 0:
        if pos + 10 >= len(command) or command[pos + 8] != "=":
            raise LaunchError("entrée %INJECT% invalide", EXIT_EMULATOR)
        inject, command = _quoted_value(command, pos, 8, "INJECT")
        if inject:
            inject = inject.replace("%BASENAME%", base_name.replace("\\", ""))
            if inject == "%ROM%":
                inject = rom_raw.replace("\\", "")
            elif not inject.startswith("/"):
                inject = es_parent(rom_path.replace("\\", "")) + "/" + inject
            if os.path.isfile(inject) or os.path.islink(inject):
                arguments = ""
                try:
                    with open(inject, encoding="utf-8", errors="replace", newline="") as fh:
                        for line in fh:
                            arguments += line.rstrip("\n").replace("\r", "")
                            if len(arguments) > 4096:
                                break
                except OSError:
                    arguments = ""
                if not arguments:
                    log("%s vide ou illisible : rien à injecter" % inject)
                elif len(arguments) > 4096:
                    warn("%s dépasse 4096 octets : ignoré, comme ES-DE" % inject)
                else:
                    command = command[:pos] + arguments + " " + command[pos:]
                    res.notes.append("injecté depuis %s" % inject)
            else:
                log("%s absent : rien à injecter" % inject)
        pos = command.find("%INJECT%")

    if is_shortcut:
        desktop = rom_path.replace("\\", "")
        if not os.path.exists(desktop) or os.path.isdir(desktop):
            raise LaunchError("fichier .desktop introuvable ou illisible : %s" % desktop, EXIT_EMULATOR)
        valid = exec_entry = False
        with open(desktop, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if line.startswith("#!"):
                    continue
                if "[Desktop Entry]" in line:
                    valid = True
                    continue
                if line.startswith("Path=") and not start_dir:
                    tmp = expand_home(line[5:], ctx.home_dir)
                    if not tmp:
                        continue
                    if os.path.isdir(tmp):
                        start_dir = tmp
                    else:
                        warn("Path= désigne un dossier inexistant : %s" % tmp)
                if line.startswith("Exec="):
                    rom_path = strip_field_codes(line[5:])
                    command = command.replace(emulator, "")
                    exec_entry = True
        if not valid or not exec_entry:
            raise LaunchError("fichier .desktop invalide (pas de [Desktop Entry] ou d'Exec=) : %s" % desktop,
                              EXIT_EMULATOR)
        res.notes.append("raccourci .desktop : ligne Exec= exécutée")

    command = command.replace("%ROM%", rom_path)
    command = command.replace("%BASENAME%", base_name)
    command = command.replace("%FILENAME%", file_name)
    command = command.replace("%ROMRAW%", rom_raw)
    command = command.replace("%ROMRAWWIN%", rom_raw_win)
    command = command.replace("%ROMPATH%", es_escape(ctx.rom_dir))
    if "%ESPATH%" in command and ctx.kind == "appimage":
        warn("%ESPATH% désigne le montage temporaire de l'AppImage d'ES-DE")
    command = command.replace("%ESPATH%", ctx.es_path)
    command = command.replace("%EMUDIR%", es_escape(es_parent(emulator.replace("\\", ""))))
    command = command.replace("%GAMEDIR%", es_escape(es_parent(rom_path.replace("\\", ""))))
    command = command.replace("%GAMEDIRRAW%", es_parent(rom_path.replace("\\", "")))
    command = command.strip()

    leftover = sorted(set(v for v in re.findall(r"%([A-Z][A-Z0-9_!\-]*)%", command)
                          if v != "RPCS3_GAMEID"))
    if leftover:
        warn("variable(s) laissée(s) telle(s) quelle(s), comme le ferait ES-DE : %s"
             % ", ".join("%" + v + "%" for v in leftover))
    res.command = command
    res.cwd = start_dir or None
    res.rom_path = rom_path
    return res


