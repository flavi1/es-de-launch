class Context:
    def __init__(self, conf, config_dir, home_dir, es_path, settings, systems, emulators, cores,
                 systems_file="", find_rules_file="", kind=""):
        self.conf = conf
        self.config_dir = config_dir
        self.home_dir = home_dir
        self.es_path = es_path or ""
        self.settings = settings
        self.systems = systems
        self.emulators = emulators
        self.cores = cores
        self.systems_file = systems_file
        self.find_rules_file = find_rules_file
        self.kind = kind
        self.rom_dir = rom_directory(settings, home_dir, self.es_path)  # avec / final, comme ES-DE

    @property
    def resources_dir(self):
        return os.path.dirname(self.systems_file)

    def library_systems(self):
        """Systèmes ayant un gamelist ou un dossier de ROMs non vide."""
        out = []
        for s in self.ordered_systems():
            gl = os.path.join(self.config_dir, "gamelists", s.name, "gamelist.xml")
            if os.path.isfile(gl) or (s.path and os.path.isdir(s.path) and os.listdir(s.path)):
                out.append(s)
        return out

    def ordered_systems(self):
        return sorted(self.systems.values(), key=lambda s: s.order)


def resolve_resources(conf, args, config_dir):
    """(dossier des XML embarqués, type d'installation, exécutable).
    Ordre : option, conf, installation déclarée dans la conf, journal d'ES-DE,
    puis chaque installation détectée (la première exploitable gagne)."""
    refresh = getattr(args, "refresh_cache", False)
    exe = expand(conf.get("install", "executable"))
    if getattr(args, "resources_dir", None):
        return os.path.abspath(expand(args.resources_dir)), "manual", exe
    configured = conf.get("install", "resources_dir", "auto")
    kind = conf.get("install", "type", "auto") or "auto"
    if configured and configured != "auto":
        return os.path.abspath(expand(configured)), (kind if kind != "auto" else "manual"), exe
    tried = []
    if exe and kind != "auto":
        if not os.path.exists(exe):
            warn("exécutable de la conf introuvable (%s) : détection automatique" % exe)
        elif kind == "appimage" or is_appimage(os.path.realpath(exe)):
            return extract_appimage_resources(exe, conf.cache_dir, config_dir, force=refresh), "appimage", exe
        else:
            k, _real, res = classify_install(exe)
            if has_resources(res):
                return res, k, exe
            tried.append("%s (%s) : pas de ressources dans %s" % (exe, k, res))
    from_log = resources_from_log(config_dir)
    if from_log:
        log("ressources lues dans es_log.txt : %s" % from_log)
        k = "flatpak" if "/flatpak/" in from_log else "snap" if "/snap/" in from_log else "system"
        return from_log, k, exe
    for c in detect_install():
        if c["type"] == "appimage":
            try:
                return (extract_appimage_resources(c["executable"], conf.cache_dir, config_dir, force=refresh),
                        "appimage", c["executable"])
            except LaunchError as e:
                tried.append("%s (appimage) : %s" % (c["executable"], e))
        elif c["valid"]:
            return c["resources_dir"], c["type"], c["executable"]
        else:
            tried.append("%s (%s) : pas de ressources dans %s" % (c["executable"], c["type"], c["resources_dir"]))
    detail = ("\n  " + "\n  ".join(tried)) if tried else " aucune installation trouvée"
    raise LaunchError("ressources ES-DE introuvables ; indiquez --resources-dir ou complétez "
                      "[install] dans la conf.%s" % detail, EXIT_CONFIG)


def resource_file(config_dir, base_dir, name):
    """getResourcePath() : <données ES-DE>/resources/systems/<os>/<fichier> a priorité,
    fichier par fichier, sur les ressources de l'installation."""
    override = os.path.join(config_dir, "resources", "systems", SYSTEMS_DIR, name)
    if os.path.isfile(override):
        log("%s remplacé par %s" % (name, override))
        return override
    return os.path.join(base_dir, name)


def build_context(conf, args):
    exe = expand(conf.get("install", "executable"))
    home_dir = esde_home(exe, conf.get("install", "home"))
    configured = args.config_dir or conf.get("install", "config_dir")
    config_dir = os.path.abspath(expand(configured)) if configured else detect_config_dir(home_dir)
    if not os.path.isdir(config_dir):
        raise LaunchError("dossier de données ES-DE introuvable : %s" % config_dir, EXIT_CONFIG)
    base, kind, exe = resolve_resources(conf, args, config_dir)
    if kind in SANDBOXED:
        warn("installation %s : aucune version de ce type n'est prévue par le code d'ES-DE ; "
             "les commandes sont exécutées sur l'hôte" % kind)
    if kind == "appimage":
        es_path = es_path_from_log(config_dir)
    elif exe and os.path.exists(exe):
        es_path = os.path.dirname(os.path.realpath(exe))
    else:
        es_path = None
    settings = load_settings(config_dir)
    rom_dir = rom_directory(settings, home_dir, es_path or "")
    systems_file = resource_file(config_dir, base, "es_systems.xml")
    find_rules_file = resource_file(config_dir, base, "es_find_rules.xml")
    systems = load_systems(systems_file, config_dir, rom_dir, home_dir)
    emulators, cores = load_find_rules(find_rules_file, config_dir)
    log("config ES-DE : %s ; ressources : %s ; ROMs : %s" % (config_dir, base, rom_dir))
    return Context(conf, config_dir, home_dir, es_path, settings, systems, emulators, cores,
                   systems_file, find_rules_file, kind)


