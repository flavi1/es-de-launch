def scripts_enabled(ctx, args):
    if args.no_scripts:
        return False
    if args.scripts:
        return True
    mode = ctx.conf.get("launch", "scripts", "always")
    if mode == "never":
        return False
    if mode == "auto":
        return bool(ctx.settings.get("CustomEventScripts"))
    return True


def event_scripts(ctx, event):
    """Toutes les entrées du dossier, triées en respectant la casse (comme ES-DE sous Linux)."""
    d = os.path.join(ctx.config_dir, "scripts", event)
    if not os.path.isdir(d):
        return []
    return sorted(d + "/" + name for name in os.listdir(d))


def script_command_line(script, args):
    """Ligne passée à system() par Scripting::fireEvent()."""
    parts = ['"%s"' % script]
    for a in args:
        parts.append(a if (not a or a.startswith('"')) else '"%s"' % a)
    return " ".join(parts)


def run_scripts(ctx, event, script_args, env):
    for s in event_scripts(ctx, event):
        line = script_command_line(s, script_args)
        log("script %s : %s" % (event, line))
        try:
            subprocess.call(["/bin/sh", "-c", line], env=env)
        except OSError as e:
            warn("échec du script %s : %s" % (s, e))


def game_name(gl_game, rom):
    if gl_game and gl_game.get("name"):
        return gl_game["name"]
    name = os.path.basename(rom.rstrip("/"))
    if os.path.isdir(rom):
        ext = es_extension(rom)
        return name[:-len(ext)] if ext != "." else name
    return es_stem(rom)


def launch(ctx, args, system, rom, det, res):
    cache = ctx.conf.cache_dir
    os.makedirs(cache, exist_ok=True)
    # Pas de verrou : ES-DE n'empêche pas deux lancements simultanés.

    if res.cwd and not os.path.isdir(res.cwd):
        try:
            os.makedirs(res.cwd)  # ES-DE crée le dossier de %STARTDIR%
        except OSError as e:
            raise LaunchError("impossible de créer %s : %s" % (res.cwd, e), EXIT_EMULATOR)

    gl = Gamelist.load(ctx, system)
    name = game_name(gl.game(rom), rom)
    script_args = [res.rom_path, name, system.name, system.fullname]
    env = dict(os.environ)
    env.update({"ESDE_LAUNCHER": "es-de-launch", "ESDE_SYSTEM": system.name,
                "ESDE_EMULATOR_LABEL": res.label, "ESDE_DETECTION_METHOD": det.method})
    use_scripts = scripts_enabled(ctx, args)
    logpath = os.path.join(cache, "last_run.log")
    rc = EXIT_ERROR
    proc = None

    def forward(signum, _frame):
        if proc and proc.poll() is None:
            try:
                os.killpg(proc.pid, signum)
            except OSError:
                pass

    old = {s: signal.signal(s, forward) for s in (signal.SIGINT, signal.SIGTERM)}
    try:
        if use_scripts:
            run_scripts(ctx, "game-start", script_args, env)
        log("lancement : %s" % res.shell_command)
        with open(logpath, "w", encoding="utf-8") as logfh:
            logfh.write("# %s\n# %s\n" % (datetime.datetime.now().isoformat(timespec="seconds"),
                                         res.shell_command))
            logfh.flush()
            out = None if VERBOSE else logfh
            try:
                proc = subprocess.Popen(["/bin/sh", "-c", res.shell_command], stdout=out, stderr=out,
                                        env=env, start_new_session=True)
            except OSError as e:
                raise LaunchError("échec du lancement : %s" % e, EXIT_EMULATOR)
            while True:
                try:
                    rc = proc.wait()
                    break
                except InterruptedError:
                    continue
    finally:
        if use_scripts:
            run_scripts(ctx, "game-end", script_args, env)
        for s, h in old.items():
            signal.signal(s, h)
    return rc if rc >= 0 else 128 - rc


