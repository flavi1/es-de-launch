        return "wii"
    return None


def sniff_nintendo_disc(rd, head):
    kind = _disc_header_kind(head)
    if kind:
        return (CERTAIN, [kind], "disque %s" % ("GameCube" if kind == "gc" else "Wii"))
    if head[:4] in (b"RVZ\x01", b"WIA\x01"):
        fmt = head[:3].decode()
        dtype = struct.unpack(">I", head[0x48:0x4C])[0]
        kind = {1: "gc", 2: "wii"}.get(dtype) or _disc_header_kind(head[0x58:0x58 + 0x80])
        if kind:
            return (CERTAIN, [kind], "%s : disque %s" % (fmt, "GameCube" if kind == "gc" else "Wii"))
        return (PROBABLE, ["gc", "wii"], "conteneur %s" % fmt)
    if head[:4] == b"\x01\xc0\x0b\xb1":  # GCZ (0xB10BC001, petit-boutiste)
        sub = struct.unpack("<I", head[4:8])[0]
        kind = {0: "gc", 1: "wii"}.get(sub)
        if kind:
            return (CERTAIN, [kind], "GCZ : disque %s" % ("GameCube" if kind == "gc" else "Wii"))
    if head[:4] == b"CISO" and struct.unpack("<I", head[4:8])[0] not in (0, 0x18):
        kind = _disc_header_kind(rd.read(0x8000, 0x20)) if rd else None
        if kind:
            return (CERTAIN, [kind], "CISO : disque %s" % ("GameCube" if kind == "gc" else "Wii"))
    if head[:4] == b"WBFS":
        if rd and rd.read(0x218, 4) == WII_MAGIC:
            return (CERTAIN, ["wii"], "WBFS : disque Wii")
        return (PROBABLE, ["wii"], "conteneur WBFS")
    if head[:4] == b"\xae\x0f\x38\xa2":
        return (CERTAIN, ["gc"], "TGC (GameCube)")
    return None


# ---- CHD (MAME) : métadonnées seulement, le contenu est compressé -------------

CHD_TAGS = {b"CHGD": "GD-ROM", b"CHCD": "CD", b"CHTR": "CD", b"CHT2": "CD", b"DVD ": "DVD", b"GDDD": "disque dur"}


def chd_kind(rd):
    h = rd.read(0, 124)
    if h[:8] != b"MComprHD":
        return None
    version = struct.unpack(">I", h[12:16])[0]
    meta = struct.unpack(">Q", h[48:56] if version >= 5 else h[36:44])[0]
    kinds = []
    for _ in range(64):
        if not meta:
            break
        entry = rd.read(meta, 16)
        if len(entry) < 16:
            break
        kind = CHD_TAGS.get(entry[:4])
        if kind and kind not in kinds:
            kinds.append(kind)
        meta = struct.unpack(">Q", entry[8:16])[0]
    return version, kinds


def sniff_chd(rd):
    r = chd_kind(rd)
    if r is None:
        return None
    version, kinds = r
    label = "CHD v%d (%s)" % (version, ", ".join(kinds) or "type inconnu")
    if "GD-ROM" in kinds:
        return (PROBABLE, ["dreamcast", "arcade"], label)
    if "DVD" in kinds:
        return (PROBABLE, ["ps2", "psp"], label)
    return ("INFO", None, label)  # CD : ne restreint pas les candidats


# ---- Cartouches ---------------------------------------------------------------

def snes_header(head, size):
    """Valide l'en-tête interne SNES (LoROM ou HiROM, avec ou sans en-tête de copieur)."""
    copier = 512 if size % 1024 == 512 else 0
    for base in (0x7FC0, 0xFFC0):
        h = head[base + copier:base + copier + 32]
        if len(h) < 32:
            continue
        comp, chk = struct.unpack("<HH", h[0x1C:0x20])
        title = h[:21]
        if comp ^ chk == 0xFFFF and (h[0x15] & 0xE0) == 0x20 \
                and all(32 <= c < 127 for c in title if c):
            return "%s, « %s »" % ("HiROM" if base == 0xFFC0 else "LoROM", title.decode("ascii").strip())
    return None


def virtualboy_header(tail, size):
    """En-tête Virtual Boy, 0x220 octets avant la fin d'une ROM de taille puissance de 2."""
    if size < 0x10000 or size > 0x1000000 or size & (size - 1) or len(tail) < 0x220:
        return None
    h = tail[-0x220:]
    maker, code = h[25:27], h[27:31]
    if h[20:25] == b"\x00" * 5 and maker.isalnum() and code.isalnum():
        return h[:20].split(b"\x00")[0].decode("shift_jis", "replace").strip() or code.decode()
    return None


def sniff_bytes(head, rd=None, size=0, tail=b""):
    """Signatures d'en-tête. Retourne (niveau, [plateformes], méthode) ou None."""
    def at(off, n):
        return head[off:off + n]

    size = size or len(head)
    order = n64_byte_order(head)
    if order:
        return (PROBABLE, ["n64"], "en-tête N64 (%s)" % order)
    if head[:4] == b"NES\x1a":
        return (PROBABLE, ["nes", "famicom"], "en-tête iNES")
    if head[:4] == b"FDS\x1a" or at(1, 14) == b"*NINTENDO-HVC*":
        return (PROBABLE, ["fds"], "en-tête FDS")
    r = sniff_nintendo_disc(rd, head)
    if r:
        return r
    if head[:8] == b"MComprHD" and rd:
        r = sniff_chd(rd)
        if r:
            return r
    if at(4, 8) == GBA_LOGO and len(head) > 0xB2 and head[0xB2] == 0x96:
        return (PROBABLE, ["gba"], "en-tête GBA")
    if at(0xC0, 8) == GBA_LOGO:
        return (PROBABLE, ["nds"], "en-tête Nintendo DS")
    if at(0x104, 8) == GB_LOGO:
        if len(head) > 0x143 and head[0x143] in (0x80, 0xC0):
            return (PROBABLE, ["gbc"], "en-tête Game Boy Color")
        return (PROBABLE, ["gb"], "en-tête Game Boy")
    if at(0x100, 4) in (b"NCSD", b"NCCH") or head[:4] == b"3DSX":
        return (PROBABLE, ["n3ds"], "en-tête 3DS")
    if at(0x100, 4) == b"HEAD" or head[:4] in (b"PFS0", b"NSO0") or at(0x10, 4) == b"NRO0":
        return (PROBABLE, ["switch"], "conteneur Switch")
    if head[:4] == b"WUX0":
        return (PROBABLE, ["wiiu"], "conteneur WUX (Wii U)")
    if at(0x100, 8) == b"SEGA 32X":
        return (PROBABLE, ["sega32x"], "en-tête 32X")
    if at(0x100, 4) == b"SEGA" or at(0x101, 4) == b"SEGA":
        return (PROBABLE, ["genesis", "megadrive"], "en-tête Mega Drive")
    for off in (0x7FF0, 0x3FF0, 0x1FF0):
        if at(off, 8) == b"TMR SEGA" and len(head) > off + 0xF:
            region = head[off + 0xF] >> 4
            if region in (5, 6, 7):
                return (PROBABLE, ["gamegear"], "en-tête Game Gear")
            return (PROBABLE, ["mastersystem"], "en-tête Master System")
    for off in (0x0, 0x10):
        tag = at(off, 15)
        if tag == b"SEGA SEGASATURN":
            return (CERTAIN, ["saturn"], "disque Saturn")
        if tag == b"SEGA SEGAKATANA":
            return (CERTAIN, ["dreamcast"], "disque Dreamcast")
        if tag[:14] == b"SEGADISCSYSTEM":
            return (CERTAIN, ["segacd"], "disque Mega-CD")
        if at(off, 7) == b"\x01ZZZZZ\x01":
            return (PROBABLE, ["3do"], "disque 3DO")
    if head[:4] == b"LYNX":
        return (PROBABLE, ["atarilynx"], "en-tête Lynx")
    if at(1, 9) == b"ATARI7800":
        return (PROBABLE, ["atari7800"], "en-tête Atari 7800")
    if at(0, 28) in (b"COPYRIGHT BY SNK CORPORATION", b" LICENSED BY SNK CORPORATION"):
        if len(head) > 0x23 and head[0x23] == 0x10:
            return (PROBABLE, ["ngpc"], "en-tête Neo Geo Pocket Color")
        return (PROBABLE, ["ngp"], "en-tête Neo Geo Pocket")
    if head[:8] == b"PS-X EXE":
        return (PROBABLE, ["psx"], "exécutable PS-X")
    if head[:4] == b"\x00PBP":
        return (PROBABLE, ["psp", "psx"], "conteneur PBP")
    if head[:2] in (b"\xaa\x55", b"\x55\xaa") and size <= 0x80000:
        return (WEAK, ["colecovision"], "en-tête ColecoVision")
    if rd is not None:
        try:
            r = sniff_iso(rd)
        except (OSError, struct.error, IndexError, zlib.error):
            r = None
        if r:
            return r
        if rd.read(0x10000, 20) == b"MICROSOFT*XBOX*MEDIA":
            return (CERTAIN, ["xbox"], "XISO (Xbox)")
    if b"PC Engine CD-ROM SYSTEM" in head:
        return (PROBABLE, ["pcenginecd"], "disque PC Engine CD")
    s = snes_header(head, size)
    if s:
        return (PROBABLE, ["snes"], "en-tête SNES (%s)" % s)
    v = virtualboy_header(tail, size)
    if v:
        return (PROBABLE, ["virtualboy"], "en-tête Virtual Boy (« %s »)" % v)
    return None


def sniff_file(path):
    """Signatures d'un fichier, d'un dossier ou d'une archive."""
    if os.path.isdir(path):
        if os.path.isdir(os.path.join(path, "PS3_GAME")) or os.path.isfile(os.path.join(path, "PS3_DISC.SFB")):
            return (CERTAIN, ["ps3"], "dossier PS3_GAME")
        return None
    ext = os.path.splitext(path)[1].lower()
    if ext in (".cue", ".gdi", ".m3u", ".ccd"):
        for f in related_files(path):  # première piste reconnue
            r = sniff_file(f)
            if r and r[0] not in ("INFO",):
                return (r[0], r[1], "%s > %s" % (os.path.basename(f), r[2]))
        return None
    if ext == ".zip":
        return sniff_zip(path)
    if ext == ".7z":
        return sniff_7z(path)
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            head = fh.read(HEAD_SIZE)
            if head[:4] == b"CISO":
                try:
                    cso = CsoReader(fh)
                    r = sniff_bytes(cso.read(0, HEAD_SIZE), cso, cso.size)
                    if r:
                        return (r[0], r[1], "CSO : " + r[2])
                except (ValueError, struct.error, zlib.error):
                    pass
            tail = read_at(fh, max(0, size - 0x220), 0x220) if size >= 0x220 else b""
            return sniff_bytes(head, FileReader(fh, size), size, tail)
    except OSError:
        return None


ARCADE_HINT = re.compile(r"^[a-z0-9_]{1,12}\.[a-z0-9]{1,4}$", re.I)


def _sniff_archive_member(name, head, size, members):
    if len(members) >= 3 and all(ARCADE_HINT.match(os.path.basename(m)) for m in members):
        return (WEAK, ["arcade"], "archive de type romset arcade")
    r = sniff_bytes(head, None, size)
    if r and r[1]:
        return (r[0], r[1], "%s : %s" % (name, r[2]))
    return ("ZIPEXT", os.path.splitext(name)[1], name)


def sniff_zip(path):
    try:
        with zipfile.ZipFile(path) as zf:
            infos = [i for i in zf.infolist() if not i.is_dir()]
            if not infos:
                return None
            biggest = max(infos, key=lambda i: i.file_size)
            with zf.open(biggest) as fh:
                head = fh.read(HEAD_SIZE)
            return _sniff_archive_member(biggest.filename, head, biggest.file_size,
                                         [i.filename for i in infos])
    except (zipfile.BadZipFile, OSError, RuntimeError):
        return None


def list_7z(path):
    """[(nom, taille)] d'une archive 7z, via py7zr ou la commande 7z."""
    try:
        import py7zr  # optionnel
        with py7zr.SevenZipFile(path) as z:
            return [(i.filename, i.uncompressed) for i in z.list() if not i.is_directory]
    except ImportError:
        pass
    except Exception:
        return None
    exe = shutil.which("7z") or shutil.which("7zz") or shutil.which("7za")
    if not exe:
        return None
    try:
        out = subprocess.run([exe, "l", "-slt", "-ba", path], capture_output=True, text=True,
                             timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    items, cur = [], {}
    for line in out.splitlines() + [""]:
        if not line.strip():
            if cur.get("Path") and "D" not in cur.get("Attributes", ""):
                items.append((cur["Path"], int(cur.get("Size") or 0)))
            cur = {}
        elif " = " in line:
            k, v = line.split(" = ", 1)
            cur[k.strip()] = v.strip()
    return items


def read_7z_member(path, name, n):
    exe = shutil.which("7z") or shutil.which("7zz") or shutil.which("7za")
    if not exe:
        return b""
    try:
        p = subprocess.Popen([exe, "e", "-so", path, name], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL)
        data = p.stdout.read(n)
        p.kill()
        p.wait()
        p.stdout.close()
        return data
    except OSError:
        return b""


def sniff_7z(path):
    items = list_7z(path)
    if not items:
        return None
    name, size = max(items, key=lambda i: i[1])
    return _sniff_archive_member(name, read_7z_member(path, name, HEAD_SIZE), size, [i[0] for i in items])


def mime_type(path):
    if os.path.isdir(path):
        return None
    try:
        import magic  # python-magic, optionnel
        return magic.from_file(path, mime=True)
    except Exception:
        pass
    exe = shutil.which("file")
    if exe:
        try:
            out = subprocess.run([exe, "--brief", "--mime-type", path], capture_output=True,
                                 text=True, timeout=10)
            return out.stdout.strip() or None
        except (OSError, subprocess.SubprocessError):
            return None
    return None


def related_files(path):
    """Fichiers référencés par un .cue / .gdi / .m3u / .ccd (spec §7 --copy)."""
    d = os.path.dirname(path)
    ext = os.path.splitext(path)[1].lower()
    out = []
    try:
        if ext == ".cue":
            with open(path, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    m = re.match(r'\s*FILE\s+"([^"]+)"', line, re.I) or re.match(r"\s*FILE\s+(\S+)", line, re.I)
                    if m:
                        out.append(os.path.join(d, m.group(1)))
        elif ext == ".gdi":
            with open(path, encoding="utf-8", errors="replace") as fh:
                for line in list(fh)[1:]:
                    m = re.match(r'\s*\d+\s+\d+\s+\d+\s+\d+\s+(?:"([^"]+)"|(\S+))', line)
                    if m:
                        out.append(os.path.join(d, m.group(1) or m.group(2)))
        elif ext == ".m3u":
            with open(path, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    line = line.strip()
                    if line and not line.startswith("#"):
                        out.append(os.path.join(d, line))
        elif ext == ".ccd":
            stem = os.path.splitext(path)[0]
            for e in (".img", ".sub"):
                if os.path.exists(stem + e):
                    out.append(stem + e)
    except OSError:
        pass
    return out


class Detection:
    def __init__(self):
        self.system = None
        self.method = ""
        self.level = 0
        self.candidates = []
        self.in_library = False
        self.dir_hint = None
        self.warnings = []
        self.mime = None
        self.sniff = None


def systems_for_platforms(ctx, platforms):
    out = []
    for s in ctx.ordered_systems():
        if s.name in platforms or any(p in platforms for p in s.platforms):
            out.append(s.name)
    return out


def detect_system(ctx, rom, forced=None, interactive=None, assume_yes=False):
    det = Detection()
    ext = es_extension(rom)  # « . » si pas d'extension, comme ES-DE
    conf = ctx.conf
    excluded = set(conf.list("systems", "exclude"))

    # 1. forçage
    if forced:
        if forced not in ctx.systems:
            raise LaunchError("système inconnu : %s" % forced, EXIT_SYSTEM)
        det.system, det.level, det.method = forced, CERTAIN, "--system"
        det.in_library = _under(rom, ctx.systems[forced].path)
        return det

    # 2. chemin dans la bibliothèque. Plusieurs systèmes peuvent partager un dossier
    # (ex. n64 et un système personnalisé pour les .wad du même dossier) : ES-DE montre le
    # fichier dans chaque système qui déclare son extension. On retient d'abord ceux-là,
    # puis le dossier le plus précis, puis l'ordre de chargement (personnalisés d'abord).
    real_rom = os.path.realpath(rom)
    is_game = not (os.path.isdir(rom) and ext == ".")  # populateFolder() : dossier sans extension
    containing = [s for s in ctx.ordered_systems()
                  if s.path and (_under(rom, s.path) or _under(real_rom, os.path.realpath(s.path)))]
    accepting = [s for s in containing if is_game and s.accepts(ext)]
    if accepting:
        longest = max(len(s.path) for s in accepting)
        same = [s for s in accepting if len(s.path) == longest]
        det.system, det.level, det.method, det.in_library = same[0].name, CERTAIN, "chemin", True
        det.candidates = [s.name for s in same]
        if len(same) > 1:
            det.warnings.append("%s apparaît dans plusieurs systèmes ES-DE (%s) : %s retenu ; "
                                "--system pour un autre" % (os.path.basename(rom),
                                                            ", ".join(det.candidates), same[0].name))
        return det
    best = max(containing, key=lambda s: len(s.path)) if containing else None
    if best:
        det.dir_hint = best.name
        msg = "%s est dans le dossier du système %s mais l'extension %r n'y est pas déclarée : " \
              "ES-DE ne l'afficherait pas" % (os.path.basename(rom), best.name, ext)
        if best.accepts(ext, ignore_case=True):
            msg += " (seule la casse diffère)"
        det.warnings.append(msg)

    levels = {}
    if det.dir_hint and ctx.systems[det.dir_hint].accepts(ext, ignore_case=True) \
            and det.dir_hint not in excluded:
        levels[WEAK] = ([det.dir_hint], ["dossier du système (casse de l'extension)"])

    def add(level, names, method):
        names = [n for n in names if n in ctx.systems and n not in excluded]
        if names:
            cur = levels.setdefault(level, ([], []))
            for n in names:
                if n not in cur[0]:
                    cur[0].append(n)
            cur[1].append(method)

    # 3. dossiers déclarés dans la conf
    for folder, sysname in conf.folders().items():
        if _under(rom, folder):
            add(PROBABLE, [sysname], "dossier [folders]")

    # 4. signatures d'en-tête
    sn = sniff_file(rom)
    det.sniff = sn
    if sn and sn[0] == "ZIPEXT":
        inner_ext = sn[1]
        add(WEAK, [s.name for s in ctx.ordered_systems() if s.accepts(inner_ext, True) and s.accepts(ext)],
            "extension dans l'archive (%s)" % sn[2])
    elif sn and sn[0] == "INFO":
        log("signature sans effet sur le choix : %s" % sn[2])
    elif sn:
        add(sn[0], systems_for_platforms(ctx, sn[1]), sn[2])

    # 5. type MIME
    det.mime = mime_type(rom)
    if det.mime:
        overrides = conf.mime_overrides()
        if det.mime in overrides:
            add(PROBABLE, [overrides[det.mime]], "MIME %s ([mime])" % det.mime)
        elif det.mime in MIME_PLATFORMS:
            add(PROBABLE, systems_for_platforms(ctx, MIME_PLATFORMS[det.mime]), "MIME %s" % det.mime)

    # 6. extension seule
    by_ext = [s.name for s in ctx.ordered_systems() if ext and s.accepts(ext)]
    if by_ext:
        add(WEAK, by_ext, "extension %s" % ext)
    elif ext:
        ci = [s.name for s in ctx.ordered_systems() if s.accepts(ext, ignore_case=True)]
        if ci:
            det.warnings.append("l'extension %r n'est déclarée qu'avec une autre casse" % ext)
            add(WEAK, ci, "extension %s (casse ignorée)" % ext)

    if not levels:
        if det.dir_hint:
            det.system, det.level, det.method = det.dir_hint, WEAK, "dossier du système (extension non déclarée)"
            return det
        raise LaunchError("impossible de déterminer le système de %s" % rom, EXIT_SYSTEM)

    level = max(levels)
    cands, methods = levels[level]
    det.level, det.method = level, " + ".join(methods)
    # affiner avec l'extension et l'indice de dossier
    if level > WEAK and by_ext:
        both = [c for c in cands if c in by_ext]
        if both:
            cands = both
    if det.dir_hint and det.dir_hint in cands:
        cands = [det.dir_hint]
    det.candidates = list(cands)

    if len(cands) == 1:
        det.system = cands[0]
        return det

    # 7. priorités de la conf
    prio = conf.ext_priority(ext) if ext else []
    for name in prio:
        if name in cands:
            det.system, det.method = name, det.method + " + priorité [extensions]"
            return det
    for name in conf.list("systems", "priority"):
        if name in cands:
            det.system, det.method = name, det.method + " + priorité [systems]"
            return det

    policy = conf.get("launch", "ambiguity", "ask")
    if assume_yes and policy == "ask":
        policy = "fail"
    if interactive is None:
        interactive = sys.stdin.isatty() and sys.stderr.isatty()
    if policy == "first":
        det.system = cands[0]
        det.method += " + premier candidat"
        return det
    if policy == "ask" and interactive:
        print("Plusieurs systèmes possibles pour %s :" % os.path.basename(rom), file=sys.stderr)
        for i, c in enumerate(cands, 1):
            print("  %d) %s — %s" % (i, c, ctx.systems[c].fullname), file=sys.stderr)
        while True:
            print("Choix [1-%d] : " % len(cands), end="", file=sys.stderr, flush=True)
            ans = sys.stdin.readline().strip()
            if not ans:
                raise LaunchError("aucun système choisi", EXIT_SYSTEM)
            if ans.isdigit() and 1 <= int(ans) <= len(cands):
                det.system = cands[int(ans) - 1]
                det.method += " + choix interactif"
                return det
    raise LaunchError("système ambigu pour %s : %s (utilisez --system ou les priorités de la conf)"
                      % (os.path.basename(rom), ", ".join(cands)), EXIT_SYSTEM)


def _under(path, folder):
    if not folder:
        return False
    path = os.path.abspath(path)
    folder = os.path.abspath(folder)
    return path.startswith(folder.rstrip("/") + "/")


