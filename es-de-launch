# --------------------------------------------------------------------------
# Codes de sortie (spec §2)
# --------------------------------------------------------------------------
EXIT_OK = 0
EXIT_ERROR = 1
EXIT_USAGE = 2
EXIT_CONFIG = 3
EXIT_SYSTEM = 4
EXIT_EMULATOR = 5
EXIT_CONFLICT = 6


class LaunchError(Exception):
    """Erreur attendue, avec un code de sortie."""

    def __init__(self, message, code=EXIT_ERROR):
        super().__init__(message)
        self.code = code


VERBOSE = False


def log(msg):
    if VERBOSE:
        print("[es-de-launch] " + msg, file=sys.stderr)


def warn(msg):
    print("es-de-launch: attention : " + msg, file=sys.stderr)


def expand(path):
    if path is None:
        return None
    return os.path.expandvars(os.path.expanduser(path))


def home():
    return os.path.expanduser("~")


def xdg_config_home():
    return os.environ.get("XDG_CONFIG_HOME") or os.path.join(home(), ".config")


def xdg_cache_home():
    return os.environ.get("XDG_CACHE_HOME") or os.path.join(home(), ".cache")


# ==========================================================================
# Lecture des fichiers XML d'ES-DE (fidèle à ES-DE 3.5 : SystemData.cpp,
# GamelistFileParser.cpp, Settings.cpp)
# ==========================================================================

def parse_xml_multi(path):
    """Comme pugixml, accepte plusieurs éléments racine (es_settings.xml, gamelist.xml avec
    <alternativeEmulator> hors de <gameList>, es_systems.xml avec <loadExclusive/>).
    Retourne un élément englobant dont les enfants sont les racines du fichier."""
    with open(path, encoding="utf-8", errors="replace") as fh:
        text = fh.read()
    text = re.sub(r"^﻿?\s*<\?xml[^>]*\?>", "", text, count=1)
    text = re.sub(r"<!DOCTYPE[^>]*>", "", text)
    return ET.fromstring("<_doc_>" + text + "</_doc_>")


def parse_xml_file(path):
    """parse_xml_multi avec un message clair (code 3) si le fichier est mal formé."""
    try:
        return parse_xml_multi(path)
    except ET.ParseError as e:
        raise LaunchError("XML invalide : %s (%s)" % (path, e), EXIT_CONFIG)
    except OSError as e:
        raise LaunchError("lecture impossible : %s (%s)" % (path, e), EXIT_CONFIG)


def pugi_bool(value):
    """pugixml as_bool() : vrai si le premier caractère est 1, t, T, y ou Y."""
    value = (value or "").strip()
    return bool(value) and value[0] in "1tTyY"


def read_list(text):
    """readList() d'ES-DE : séparateurs espace, tabulation, retour à la ligne et virgule."""
    return [x for x in re.split(r"[ \t\r\n,]+", text or "") if x]


def expand_home(text, home_dir):
    """expandHomePath() d'ES-DE : remplace TOUS les ~ de la chaîne."""
    return text.replace("~", home_dir)


SETTING_DEFAULTS = {
    "ROMDirectory": "",
    "CustomEventScripts": False,
    "AlternativeEmulatorPerGame": True,
    "RunInBackground": False,
    "LegacyGamelistFileLocation": False,
    "ShowHiddenFiles": True,
}


def load_settings(config_dir):
    """Réglages d'es_settings.xml (format plat ou racine <settings>)."""
    settings = dict(SETTING_DEFAULTS)
    path = os.path.join(config_dir, "settings", "es_settings.xml")
    if not os.path.isfile(path):
        log("es_settings.xml absent : réglages par défaut")
        return settings
    try:
        doc = parse_xml_multi(path)
    except ET.ParseError as e:
        warn("es_settings.xml illisible (%s) : réglages par défaut, comme ES-DE" % e)
        return settings
    containers = [doc] + doc.findall("settings")
    for c in containers:
        for el in c:
            name, value = el.get("name"), el.get("value")
            if name is None or value is None:
                continue
            settings[name] = pugi_bool(value) if el.tag == "bool" else value
    return settings


def rom_directory(settings, home_dir, es_path=""):
    """getROMDirectory() : <home>/ROMs/ par défaut, ~ développé, toujours terminé par /."""
    value = settings.get("ROMDirectory") or ""
    if value == "":
        rom_dir = home_dir + "/ROMs/"
    else:
        rom_dir = expand_home(value, home_dir)
        if not rom_dir.endswith("/"):
            rom_dir += "/"
    return rom_dir.replace("%ESPATH%", es_path)


class System:
    def __init__(self, name):
        self.name = name
        self.fullname = name
        self.path_raw = ""
        self.path = ""
        self.extensions = []
        self.commands = []  # liste de (label, commande) ; label "" si absent
        self.platforms = []
        self.theme = ""
        self.custom = False
        self.order = 0

    def accepts(self, ext, ignore_case=False):
        """ES-DE compare les extensions en respectant la casse (std::find)."""
        if ignore_case:
            return ext.lower() in (e.lower() for e in self.extensions)
        return ext in self.extensions

    def command_for(self, label):
        """getLaunchCommandFromLabel()."""
        for lab, cmd in self.commands:
            if lab == label:
                return cmd
        return ""

    def to_dict(self):
        return {"name": self.name, "fullname": self.fullname, "path": self.path,
                "platforms": self.platforms, "extensions": self.extensions,
                "commands": [label for label, _ in self.commands]}


def _parse_system(el):
    name = (el.findtext("name") or "").replace("\n", "")
    s = System(name)
    s.fullname = (el.findtext("fullname") or "").replace("\n", "")
    s.path_raw = el.findtext("path") or ""
    s.extensions = read_list(el.findtext("extension"))
    for c in el.findall("command"):
        label = c.get("label")
        if label is None:
            if s.commands:  # étiquette manquante sur une commande alternative
                warn("étiquette manquante pour une commande du système %s, commandes suivantes ignorées" % name)
                break
        elif s.commands and s.commands[-1][0] == "":
            warn("la première commande du système %s n'a pas d'étiquette, seule elle est gardée" % name)
            break
        label = label or ""
        if label and any(lab == label for lab, _ in s.commands):
            warn("étiquette en double « %s » pour le système %s, ignorée" % (label, name))
            continue
        s.commands.append((label, c.text or ""))
    s.platforms = read_list((el.findtext("platform") or "").lower())
    theme = el.find("theme")
    s.theme = (theme.text if theme is not None and theme.text else name)
    return s


def load_systems(systems_file, config_dir, rom_dir, home_dir):
    """Fichier personnalisé d'abord, puis fichier embarqué ; un nom déjà chargé est ignoré ;
    <loadExclusive/> dans le fichier personnalisé désactive le fichier embarqué."""
    paths = []
    custom = os.path.join(config_dir, "custom_systems", "es_systems.xml")
    if os.path.isfile(custom):
        paths.append((custom, True))
    if not systems_file or not os.path.isfile(systems_file):
        raise LaunchError("es_systems.xml introuvable (%s)" % systems_file, EXIT_CONFIG)
    paths.append((systems_file, False))
    systems, order = {}, []
    for path, is_custom in paths:
        doc = parse_xml_file(path)
        system_list = doc.find("systemList")
        if system_list is None:
            raise LaunchError("<systemList> absent de %s" % path, EXIT_CONFIG)
        for el in system_list.findall("system"):
            s = _parse_system(el)
            if not s.name:
                warn("système sans nom dans %s, ignoré" % path)
                continue
            if s.name in systems:
                continue
            if not (s.fullname and s.path_raw and s.extensions and s.commands):
                warn("système %s incomplet (fullname, path, extension ou command), ignoré" % s.name)
                continue
            s.custom = is_custom
            p = s.path_raw.replace("%ROMPATH%", rom_dir).replace("//", "/")
            s.path = expand_home(p, home_dir).rstrip("/") or "/"
            systems[s.name] = s
            order.append(s.name)
        if is_custom and doc.find("loadExclusive") is not None and len(paths) > 1:
            log("<loadExclusive/> : es_systems.xml embarqué non chargé")
            break
    for i, name in enumerate(order):
        systems[name].order = i
    customs = [n for n in order if systems[n].custom]
    if customs:
        log("systèmes personnalisés : %s" % ", ".join(customs))
    return systems


def load_find_rules(find_rules_file, config_dir):
    """Règles de recherche : fichier personnalisé d'abord ; un émulateur ou un cœur déjà
    défini est ignoré (remplacement complet par nom). Un fichier illisible est ignoré."""
    emulators, cores = {}, {}
    paths = []
    custom = os.path.join(config_dir, "custom_systems", "es_find_rules.xml")
    if os.path.isfile(custom):
        paths.append(custom)
    if find_rules_file and os.path.isfile(find_rules_file):
        paths.append(find_rules_file)
    if not paths:
        raise LaunchError("es_find_rules.xml introuvable (%s)" % find_rules_file, EXIT_CONFIG)
    for path in paths:
        try:
            doc = parse_xml_multi(path)
        except (ET.ParseError, OSError) as e:
            warn("%s illisible (%s) : ignoré, comme le fait ES-DE" % (path, e))
            continue
        rule_list = doc.find("ruleList")
        if rule_list is None:
            warn("<ruleList> absent de %s : ignoré" % path)
            continue
        for el in rule_list.findall("emulator"):
            name = el.get("name") or ""
            if not name or name in emulators:
                continue
            rules = {"systempath": [], "staticpath": []}
            for r in el.findall("rule"):
                t = r.get("type") or ""
                if t in rules:
                    rules[t] += [e.text or "" for e in r.findall("entry")]
            emulators[name] = rules
        for el in rule_list.findall("core"):
            name = el.get("name") or ""
            if not name or name in cores:
                continue
            paths_ = []
            for r in el.findall("rule"):
                if r.get("type") == "corepath":
                    paths_ += [e.text or "" for e in r.findall("entry")]
            cores[name] = {"corepath": paths_}
    return emulators, cores


def resolve_relative(path, relative_to):
    """resolveRelativePath(..., allowHome=false) : seul ./ est résolu."""
    if path.startswith("./"):
        return relative_to + path[1:]
    return path


class Gamelist:
    def __init__(self):
        self.path = None
        self.alt_emulator = None      # étiquette valide du système
        self.alt_emulator_invalid = None
        self.games = {}               # chemin -> dict des balises

    @staticmethod
    def file_for(ctx, system):
        legacy = os.path.join(system.path, "gamelist.xml")
        if ctx.settings.get("LegacyGamelistFileLocation") and os.path.isfile(legacy):
            return legacy
        path = os.path.join(ctx.config_dir, "gamelists", system.name, "gamelist.xml")
        return path if os.path.isfile(path) else None

    @staticmethod
    def load(ctx, system):
        g = Gamelist()
        path = Gamelist.file_for(ctx, system)
        if not path:
            return g
        g.path = path
        try:
            doc = parse_xml_multi(path)
        except (ET.ParseError, OSError) as e:
            warn("gamelist illisible (%s) : %s" % (path, e))
            return g
        root = doc.find("gameList")
        if root is None:
            warn("<gameList> absent de %s" % path)
            return g
        alt = doc.find("alternativeEmulator")
        if alt is None:
            alt = root.find("alternativeEmulator")
        if alt is not None:
            label = alt.findtext("label") or ""
            if label:
                if any(lab == label for lab, _ in system.commands):
                    g.alt_emulator = label
                else:
                    g.alt_emulator_invalid = label
        for tag in ("game", "folder"):
            for el in root.findall(tag):
                p = resolve_relative(el.findtext("path") or "", system.path)
                if not p:
                    continue
                info = {child.tag: (child.text or "") for child in el}
                info["_type"] = tag
                g.games[os.path.normpath(p)] = info
        return g

    def game(self, rom):
        return self.games.get(os.path.normpath(rom))


