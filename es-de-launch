def file_hashes(path, limit=None):
    h_crc, h_md5, h_sha1 = 0, hashlib.md5(), hashlib.sha1()

    def feed(fh):
        nonlocal h_crc
        while True:
            chunk = fh.read(1 << 20)
            if not chunk:
                break
            h_crc = zlib.crc32(chunk, h_crc)
            h_md5.update(chunk)
            h_sha1.update(chunk)

    if zipfile.is_zipfile(path):
        with zipfile.ZipFile(path) as zf:
            infos = [i for i in zf.infolist() if not i.is_dir()]
            if len(infos) == 1:
                with zf.open(infos[0]) as fh:
                    feed(fh)
                return {"crc32": "%08x" % h_crc, "md5": h_md5.hexdigest(), "sha1": h_sha1.hexdigest(),
                        "on": "contenu du zip : " + infos[0].filename}
    with open(path, "rb") as fh:
        feed(fh)
    return {"crc32": "%08x" % h_crc, "md5": h_md5.hexdigest(), "sha1": h_sha1.hexdigest(), "on": "fichier"}


def suggested_extension(ctx, system, rom):
    ext = es_extension(rom)
    if system.accepts(ext):
        return None
    if system.accepts(ext, ignore_case=True):
        for e in system.extensions:
            if e.lower() == ext.lower() and e == e.lower():
                return e
    if "n64" in system.platforms:
        try:
            with open(rom, "rb") as fh:
                order = n64_byte_order(fh.read(4))
            if order:
                return "." + order
        except OSError:
            pass
    return None


def info(ctx, args, rom):
    out = {"file": {"path": os.path.abspath(rom), "exists": os.path.exists(rom)}}
    if os.path.isfile(rom):
        out["file"]["size"] = os.path.getsize(rom)
        out["file"]["extension"] = es_extension(rom)
        try:
            out["file"]["hashes"] = file_hashes(rom)
        except OSError as e:
            out["file"]["hashes"] = {"error": str(e)}
    try:
        det = detect_system(ctx, rom, args.system, interactive=False, assume_yes=True)
    except LaunchError as e:
        out["error"] = str(e)
        return out, e.code
    out["file"]["mime"] = det.mime
    if det.sniff and det.sniff[0] != "ZIPEXT":  # y compris "INFO" (CHD de CD...)
        out["file"]["header"] = det.sniff[2]
    s = ctx.systems[det.system]
    out["system"] = {"name": s.name, "fullname": s.fullname, "platforms": s.platforms,
                     "detection": det.method, "certainty": LEVEL_NAMES.get(det.level, "?"),
                     "other_candidates": [c for c in det.candidates if c != s.name]}
    gl = Gamelist.load(ctx, s)
    game = gl.game(rom)
    sug = suggested_extension(ctx, s, rom)
    dest = os.path.join(s.path, os.path.basename(rom) if not sug else
                        os.path.splitext(os.path.basename(rom))[0] + sug)
    out["library"] = {"in_library": det.in_library, "system_dir": s.path,
                      "proposed_path": None if det.in_library else dest,
                      "suggested_extension": sug,
                      "gamelist": {k: game.get(k) for k in ("name", "releasedate", "playcount", "lastplayed")
                                   if game.get(k)} if game else None}
    emus = []
    label, _cmd, reason, _g, _gm = choose_command(ctx, s, rom, args.emulator)
    for lab, c in s.commands:
        names = re.findall(r"%EMULATOR_([A-Za-z0-9_!.\-]+)%", c)
        found = all(find_emulator(ctx, "%%EMULATOR_%s%%" % n)[2] == FOUND for n in names) if names else None
        emus.append({"label": lab, "selected": lab == label, "emulator_found": found})
    out["emulator"] = {"label": label, "reason": reason, "available": emus}
    try:
        res = build_command(ctx, s, rom, args.emulator)
        out["emulator"]["command"] = res.command
        out["emulator"]["cwd"] = res.cwd
        out["emulator"]["shell_command"] = res.shell_command
        out["emulator"]["run_in_background"] = res.run_in_background
    except LaunchError as e:
        out["emulator"]["command_error"] = str(e)
    out["warnings"] = det.warnings
    return out, EXIT_OK


def print_info(data):
    f = data.get("file", {})
    print("Fichier       : %s" % f.get("path"))
    if "size" in f:
        print("Taille        : %d octets" % f["size"])
    if f.get("mime"):
        print("Type MIME     : %s" % f["mime"])
    if f.get("header"):
        print("En-tête       : %s" % f["header"])
    h = f.get("hashes") or {}
    if "crc32" in h:
        print("CRC32/SHA-1   : %s / %s (%s)" % (h["crc32"], h["sha1"], h["on"]))
    if "error" in data:
        print("Erreur        : %s" % data["error"])
        return
    s = data["system"]
    print("Système       : %s (%s)" % (s["name"], s["fullname"]))
    print("Détection     : %s [%s]" % (s["detection"], s["certainty"]))
    if s["other_candidates"]:
        print("Autres        : %s" % ", ".join(s["other_candidates"]))
    lib = data["library"]
    print("Bibliothèque  : %s" % ("oui" if lib["in_library"] else "non → " + str(lib["proposed_path"])))
    if lib.get("suggested_extension"):
        print("Extension     : renommer en %s pour qu'ES-DE l'affiche" % lib["suggested_extension"])
    if lib.get("gamelist"):
        print("Gamelist      : %s" % ", ".join("%s=%s" % kv for kv in lib["gamelist"].items()))
    e = data["emulator"]
    print("Émulateur     : %s (%s)" % (e["label"], e["reason"]))
    if e.get("command"):
        print("Commande      : %s" % e["command"])
        if e.get("cwd"):
            print("Dossier       : %s" % e["cwd"])
    if e.get("command_error"):
        print("Commande      : impossible — %s" % e["command_error"].splitlines()[0])
    print("Disponibles   :")
    for a in e["available"]:
        st = {True: "trouvé", False: "absent", None: "-"}[a["emulator_found"]]
        print("  %s %-40s %s" % ("*" if a["selected"] else " ", a["label"], st))
    for w in data.get("warnings", []):
        print("Attention     : %s" % w)


def same_content(a, b):
    if os.path.getsize(a) != os.path.getsize(b):
        return False
    with open(a, "rb") as fa, open(b, "rb") as fb:
        while True:
            x, y = fa.read(1 << 20), fb.read(1 << 20)
            if x != y:
                return False
            if not x:
                return True


def copy_rom(ctx, args, rom):
    det = detect_system(ctx, rom, args.system, assume_yes=args.yes)
    s = ctx.systems[det.system]
    for w in det.warnings:
        warn(w)
    if det.in_library and s.accepts(es_extension(rom)):
        print("Déjà rangé : %s" % rom)
        return EXIT_OK
    if not s.path:
        raise LaunchError("le système %s n'a pas de dossier" % s.name, EXIT_CONFIG)
    sug = suggested_extension(ctx, s, rom)
    main_name = os.path.basename(rom)
    if sug:
        if args.fix_ext:
            main_name = os.path.splitext(main_name)[0] + sug
        else:
            warn("extension non déclarée pour %s : ajoutez --fix-ext pour renommer en %s" % (s.name, sug))
    plan = [(rom, os.path.join(s.path, main_name))]
    for f in related_files(rom):
        if not os.path.exists(f):
            raise LaunchError("fichier lié introuvable : %s" % f)
        plan.append((f, os.path.join(s.path, os.path.relpath(f, os.path.dirname(rom)))))
    # contrôle des conflits avant toute écriture
    final = []
    for src, dst in plan:
        if os.path.exists(dst):
            if os.path.isfile(src) and same_content(src, dst):
                print("Identique, ignoré : %s" % dst)
                continue
            if args.overwrite:
                pass
            elif args.rename:
                stem, ext = os.path.splitext(dst)
                n = 1
                while os.path.exists("%s (%d)%s" % (stem, n, ext)):
                    n += 1
                dst = "%s (%d)%s" % (stem, n, ext)
            else:
                raise LaunchError("destination existante et différente : %s (--overwrite ou --rename)"
                                  % dst, EXIT_CONFLICT)
        final.append((src, dst))
    verb = "Déplacer" if args.move else "Copier"
    for src, dst in final:
        print("%s %s -> %s" % (verb, src, dst))
        if args.dry_run:
            continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        tmp = dst + ".es-de-launch.tmp"
        if os.path.isdir(src):
            if args.move:
                shutil.move(src, dst)
            else:
                shutil.copytree(src, dst)
            continue
        shutil.copy2(src, tmp)
        os.replace(tmp, dst)
        if args.move:
            os.remove(src)
    if not args.dry_run and final:
        print("ES-DE doit relire la bibliothèque (redémarrage ou rechargement) pour voir le jeu.")
    return EXIT_OK


